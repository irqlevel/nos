# tests/hv-passthrough-test.py's guest kernel: tinyconfig and these -- a
# 64-bit SMP kernel with PCI and its MSI-X, NVMe, an initramfs, devtmpfs,
# /proc/self/pagemap for nvmepoke, and an 8250 console (build-guest.sh)
CONFIG_64BIT=y
CONFIG_SMP=y
# x2APIC, as hv's guests start in it, needs a guest's or remapping's say
CONFIG_HYPERVISOR_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_X86_MPPARSE=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_NVME=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_DEVTMPFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_SYSFS=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_EARLY_PRINTK=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
