# Copy to .env and fill in; docker compose reads it.

# The domain the site is served on. Its A (and AAAA) records -- and www's --
# must point at this server before the first start, or Let's Encrypt refuses.
DOMAIN=nos.example.org

# The Let's Encrypt account's e-mail: where expiry and problem notices go.
ACME_EMAIL=admin@example.org

# Optional: the codes from Google Search Console and Yandex Webmaster, for
# verifying the site with a meta tag. Only the content="..." value.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
