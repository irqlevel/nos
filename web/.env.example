# Copy to .env and fill in; docker compose reads it.

# The domain the site is served on. Its A (and AAAA) records -- and www's --
# must point at this server before the first start, or Let's Encrypt refuses.
DOMAIN=nos.example.org

# The Let's Encrypt account's e-mail: where expiry and problem notices go.
ACME_EMAIL=admin@example.org

# The host ports Caddy is published on: a port, or address:port to bind one
# interface only (127.0.0.1:8443). Caddy stays on 80 and 443 inside its
# container, and its redirects and its certificate are those of the public 80
# and 443 -- the ports Let's Encrypt checks the domain on, from the internet.
# Other values are for when 80 and 443 still reach these: a port forward, or a
# proxy in front that passes TLS through untouched. Without that, no
# certificate can be issued.
HTTP_PORT=80
HTTPS_PORT=443

# Optional: the codes from Google Search Console and Yandex Webmaster, for
# verifying the site with a meta tag. Only the content="..." value.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
