       "ru": "запрещено"
      }
     }
    },
    "out": {
     "type": "enum",
     "title": {
      "en": "What goes out",
      "ru": "Исходящее"
     },
     "values": {
      "allow": {
       "en": "allowed",
       "ru": "разрешено"
      },
      "deny": {
       "en": "denied",
       "ru": "запрещено"
      }
     }
    }
   }
  },
  "firewall_add": {
   "kind": "action",
   "title": {
    "en": "Add a rule",
    "ru": "Добавить правило"
   },
   "help": {
    "en": "An exception to the policies, the first rule that matches a packet deciding it: allow or deny, in or out, then what it is about -- tcp, udp or icmp, ports (22, 80,443, 8000-8100) -- and from or to whom: any, net (the VM's own network) or addresses (203.0.113.0/24,198.51.100.7). allow in tcp 22 from 203.0.113.0/24; allow in from net.",
    "ru": "Исключение из политик; пакет решает первое подошедшее правило: allow или deny, in или out, затем о чём оно -- tcp, udp или icmp, порты (22, 80,443, 8000-8100) -- и откуда или куда: any, net (своя сеть машины) или адреса (203.0.113.0/24,198.51.100.7). allow in tcp 22 from 203.0.113.0/24; allow in from net."
   },
   "params": {
