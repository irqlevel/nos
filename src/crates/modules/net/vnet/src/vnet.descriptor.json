    "name": {
     "type": "string",
     "title": {
      "en": "Name",
      "ru": "Имя"
     },
     "required": true,
     "help": {
      "en": "Lowercase letters, digits and -, at most 26.",
      "ru": "Строчные буквы, цифры и -, не длиннее 26."
     }
    },
    "subnet": {
     "type": "string",
     "title": {
      "en": "Subnet",
      "ru": "Подсеть"
     },
     "required": true,
     "help": {
      "en": "a.b.c.d/prefix: 10.10.0.0/24.",
      "ru": "a.b.c.d/префикс: 10.10.0.0/24."
     }
    },
    "mtu": {
     "type": "int",
     "title": {
      "en": "MTU",
      "ru": "MTU"
     },
     "min": 576,
     "max": 1440,
     "default": 1420
    },
    "out": {
     "type": "bool",
     "title": {
      "en": "Out to the world",
      "ru": "Выход в мир"
     },
     "default": true,
     "help": {
      "en": "Its VMs masqueraded by their own host.",
      "ru": "Машины выходят через NAT своего хоста."
     }
    }
   }
  },
