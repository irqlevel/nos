{
  "schema": 1,
  "provider": "vm",
  "title": {"en": "Virtual machines", "ru": "Виртуальные машины"},
  "help": {"en": "The VMs of nos's hypervisor, each a folder of the VMs' folder, and the switch they are on.", "ru": "Виртуальные машины гипервизора nos, каждая в своей папке, и коммутатор, к которому они подключены."},
  "ui": {"section": "vms", "order": 20, "icon": "server"},
  "methods": {
    "list": {"kind": "read", "title": {"en": "VMs", "ru": "Машины"}},
    "get": {"kind": "read", "title": {"en": "VM", "ru": "Машина"}, "result": "vm",
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "host": {"kind": "read", "title": {"en": "Hypervisor", "ru": "Гипервизор"}},
    "networks": {"kind": "read", "title": {"en": "Networks", "ru": "Сети"}},
    "config_get": {"kind": "read", "title": {"en": "Its vm.toml", "ru": "Файл vm.toml"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "console_read": {"kind": "read", "title": {"en": "Console", "ru": "Консоль"},
      "help": {"en": "What the guest printed from byte from on, made safe to show -- for a terminal, its sequences kept.", "ru": "Что гость напечатал начиная с байта from, в безопасном для показа виде; для терминала с управляющими последовательностями."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "from": {"type": "int", "min": 0, "title": {"en": "From byte", "ru": "С байта"}},
        "max_bytes": {"type": "bytes", "min": 1, "max": 65536, "title": {"en": "At most", "ru": "Не больше"}},
        "terminal": {"type": "bool", "title": {"en": "For a terminal", "ru": "Для терминала"}}}},
    "disks": {"kind": "read", "title": {"en": "Disks", "ru": "Диски"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "forwards": {"kind": "read", "title": {"en": "Port forwards", "ru": "Проброс портов"}},
    "config_set": {"kind": "action", "title": {"en": "Edit vm.toml", "ru": "Изменить vm.toml"},
      "confirm": {"en": "Replace this VM's vm.toml? Its next start boots as it says.", "ru": "Заменить vm.toml? Следующий запуск будет по нему."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "text": {"type": "text", "required": true, "title": {"en": "The file", "ru": "Файл"}}}},
    "forward_add": {"kind": "action", "title": {"en": "Forward a port", "ru": "Пробросить порт"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "port": {"type": "port", "required": true, "title": {"en": "nos's port", "ru": "Порт nos"}},
        "guest_port": {"type": "port", "required": true, "title": {"en": "The guest's port", "ru": "Порт гостя"}}}},
    "forward_del": {"kind": "action", "title": {"en": "Remove a forward", "ru": "Убрать проброс"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "port": {"type": "port", "required": true, "title": {"en": "nos's port", "ru": "Порт nos"}}}},
    "console_write": {"kind": "action", "title": {"en": "Type at the console", "ru": "Ввод в консоль"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "text": {"type": "text", "required": true, "title": {"en": "Text", "ru": "Текст"}}}},
    "disk_add": {"kind": "action", "title": {"en": "Add a disk", "ru": "Добавить диск"},
      "help": {"en": "A new empty disk in its folder, read at its next start.", "ru": "Новый пустой диск в её папке; виден со следующего запуска."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "file": {"type": "string", "required": true, "title": {"en": "File", "ru": "Файл"}},
        "size_bytes": {"type": "bytes", "min": 1048576, "required": true, "title": {"en": "Size", "ru": "Размер"}}}},
    "disk_grow": {"kind": "action", "title": {"en": "Grow a disk", "ru": "Увеличить диск"},
      "confirm": {"en": "Grow this disk? It is never shrunk.", "ru": "Увеличить диск? Уменьшить его потом нельзя."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "file": {"type": "string", "required": true, "title": {"en": "File", "ru": "Файл"}},
        "size_bytes": {"type": "bytes", "min": 1, "required": true, "title": {"en": "Size", "ru": "Размер"}}}},
    "start": {"kind": "job", "title": {"en": "Start", "ru": "Запустить"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "stop": {"kind": "job", "title": {"en": "Stop", "ru": "Остановить"},
      "confirm": {"en": "Stop this VM? Its power button is pressed first.", "ru": "Остановить машину? Сначала нажимается кнопка питания."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "secs": {"type": "int", "min": 0, "max": 600, "default": 30, "title": {"en": "Seconds to shut down", "ru": "Секунд на выключение"}},
        "force": {"type": "bool", "title": {"en": "Even if protected", "ru": "Даже защищённую"}}}},
    "restart": {"kind": "job", "title": {"en": "Restart", "ru": "Перезапустить"},
      "confirm": {"en": "Restart this VM, as a reset button would?", "ru": "Перезапустить машину, как кнопкой reset?"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "create": {"kind": "job", "title": {"en": "Create from an image", "ru": "Создать из образа"},
      "help": {"en": "A cloud's image, qcow2 or raw, downloaded and made the VM's disk.", "ru": "Облачный образ, qcow2 или raw, скачивается и становится диском машины."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "url": {"type": "string", "required": true, "title": {"en": "Image URL", "ru": "URL образа"}},
        "size_bytes": {"type": "bytes", "title": {"en": "Disk size", "ru": "Размер диска"}},
        "memory_mib": {"type": "int", "min": 64, "unit": "MiB", "default": 1024, "title": {"en": "Memory", "ru": "Память"}},
        "cpus": {"type": "int", "min": 1, "default": 1, "title": {"en": "CPUs", "ru": "Процессоры"}},
        "network": {"type": "string", "title": {"en": "Network", "ru": "Сеть"}},
        "password": {"type": "string", "title": {"en": "Console password", "ru": "Пароль консоли"}},
        "user_data": {"type": "text", "title": {"en": "cloud-init user-data", "ru": "user-data для cloud-init"}}}},
    "clone": {"kind": "job", "title": {"en": "Clone", "ru": "Клонировать"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "to": {"type": "string", "required": true, "title": {"en": "New name", "ru": "Новое имя"}},
        "port": {"type": "int", "min": 0, "max": 15, "title": {"en": "Switch port", "ru": "Порт коммутатора"}}}},
    "delete": {"kind": "job", "title": {"en": "Delete", "ru": "Удалить"},
      "confirm": {"en": "Delete this VM and its disks? This cannot be undone.", "ru": "Удалить машину и её диски? Это нельзя отменить."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "keep_disks": {"type": "bool", "title": {"en": "Keep its disks", "ru": "Оставить диски"}},
        "force": {"type": "bool", "title": {"en": "Even if protected", "ru": "Даже защищённую"}}}}
  },
  "resources": {
    "vms": {
      "title": {"en": "VMs", "ru": "Машины"},
      "list": "list", "get": "get", "items": "vms", "key": "name",
      "fields": {
        "name": {"type": "string", "title": {"en": "Name", "ru": "Имя"}},
        "state": {"type": "enum", "title": {"en": "State", "ru": "Состояние"}, "values": {
          "running": {"en": "running", "ru": "работает"},
          "stopping": {"en": "stopping", "ru": "останавливается"},
          "stopped": {"en": "stopped", "ru": "остановлена"},
          "off": {"en": "off", "ru": "выключена"},
          "busy": {"en": "busy", "ru": "занята"}}},
        "cpus": {"type": "int", "title": {"en": "CPUs", "ru": "ЦП"}},
        "memory_mib": {"type": "int", "unit": "MiB", "title": {"en": "Memory", "ru": "Память"}},
        "ip": {"type": "ipv4", "title": {"en": "Address", "ru": "Адрес"}},
        "uptime_ms": {"type": "duration_ms", "title": {"en": "Up", "ru": "Работает"}},
        "restarts": {"type": "int", "title": {"en": "Restarts", "ru": "Перезапуски"}},
        "protected": {"type": "bool", "title": {"en": "Protected", "ru": "Защищена"}},
        "exits": {"type": "int", "title": {"en": "Exits", "ru": "Выходы"}}
      },
      "columns": ["name", "state", "cpus", "memory_mib", "ip", "uptime_ms"],
      "actions": [{"method": "start", "params": {"name": "$name"}}, {"method": "stop", "params": {"name": "$name"}},
        {"method": "restart", "params": {"name": "$name"}}, {"method": "clone", "params": {"name": "$name"}},
        {"method": "delete", "params": {"name": "$name"}}]
    },
    "disks": {
      "title": {"en": "Disks", "ru": "Диски"},
      "list": "disks", "items": "disks", "key": "file", "parent": "vms",
      "fields": {
        "file": {"type": "string", "title": {"en": "File", "ru": "Файл"}},
        "size_bytes": {"type": "bytes", "title": {"en": "Size", "ru": "Размер"}},
        "read_only": {"type": "bool", "title": {"en": "Read-only", "ru": "Только чтение"}},
        "vm": {"type": "string", "title": {"en": "VM", "ru": "Машина"}}
      },
      "columns": ["file", "size_bytes", "read_only"],
      "actions": [{"method": "disk_grow", "params": {"name": "$vm", "file": "$file"}}]
    },
    "forwards": {
      "title": {"en": "Port forwards", "ru": "Проброс портов"},
      "list": "forwards", "items": "forwards", "key": "port",
      "fields": {
        "port": {"type": "port", "title": {"en": "nos's port", "ru": "Порт nos"}},
        "vm": {"type": "string", "title": {"en": "VM", "ru": "Машина"}},
        "guest_ip": {"type": "ipv4", "title": {"en": "Guest", "ru": "Гость"}},
        "guest_port": {"type": "port", "title": {"en": "Its port", "ru": "Его порт"}},
        "active": {"type": "int", "title": {"en": "Connections", "ru": "Соединения"}}
      },
      "columns": ["port", "vm", "guest_ip", "guest_port", "active"],
      "actions": [{"method": "forward_del", "params": {"name": "$vm", "port": "$port"}}]
    }
  },
  "metrics": {
    "exits": {"title": {"en": "VM exits", "ru": "Выходы из гостя"}, "method": "list", "items": "vms", "key": "name",
      "field": "exits", "kind": "rate", "unit": "1/s"}
  }
}
