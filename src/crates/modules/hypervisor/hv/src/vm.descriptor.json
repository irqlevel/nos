{
  "schema": 1,
  "provider": "vm",
  "title": {"en": "Virtual machines", "ru": "Виртуальные машины"},
  "help": {"en": "The VMs of nos's hypervisor, each a folder of the VMs' folder, and the switch they are on.", "ru": "Виртуальные машины гипервизора nos, каждая в своей папке, и коммутатор, к которому они подключены."},
  "ui": {"section": "vms", "order": 20, "icon": "server"},
  "methods": {
    "list": {"kind": "read", "title": {"en": "VMs", "ru": "Машины"}},
    "get": {"kind": "read", "title": {"en": "VM", "ru": "Машина"}, "result": "vm",
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "host": {"kind": "read", "title": {"en": "Hypervisor", "ru": "Гипервизор"}},
    "networks": {"kind": "read", "title": {"en": "Networks", "ru": "Сети"}},
    "config_get": {"kind": "read", "title": {"en": "Its vm.toml", "ru": "Файл vm.toml"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "console_read": {"kind": "read", "title": {"en": "Console", "ru": "Консоль"},
      "help": {"en": "What the guest printed from byte from on, made safe to show -- for a terminal, its sequences kept.", "ru": "Что гость напечатал начиная с байта from, в безопасном для показа виде; для терминала с управляющими последовательностями."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "from": {"type": "int", "min": 0, "title": {"en": "From byte", "ru": "С байта"}},
        "max_bytes": {"type": "bytes", "min": 1, "max": 65536, "title": {"en": "At most", "ru": "Не больше"}},
        "terminal": {"type": "bool", "title": {"en": "For a terminal", "ru": "Для терминала"}}}},
    "disks": {"kind": "read", "title": {"en": "Disks", "ru": "Диски"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "disk_io": {"kind": "read", "title": {"en": "Disk activity", "ru": "Активность дисков"},
      "help": {"en": "What each disk of a running VM has done since its boot -- reads, writes and their bytes, flushes, errors, and the time its requests waited -- and when that was read: IOPS, bandwidth and latency are made of two.", "ru": "Что сделал каждый диск работающей машины с её загрузки -- чтения, записи и их байты, сбросы, ошибки и сколько ждали его запросы -- и когда это прочитано: IOPS, пропускная способность и задержка считаются по двум таким ответам."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "devices": {"kind": "read", "title": {"en": "Devices", "ru": "Устройства"}},
    "pci": {"kind": "read", "title": {"en": "PCI functions", "ru": "PCI-функции"},
      "help": {"en": "The host's PCI functions as VMs are given them: a driver's or kept for guests (guestpci=), the reset, the interrupts, the IOMMU group, and why not where one cannot be given.", "ru": "PCI-функции хоста так, как их получают машины: у драйвера или оставлена гостям (guestpci=), сброс, прерывания, группа IOMMU и почему нельзя, если нельзя."}},
    "forwards": {"kind": "read", "title": {"en": "Port forwards", "ru": "Проброс портов"}},
    "config_set": {"kind": "action", "title": {"en": "Edit vm.toml", "ru": "Изменить vm.toml"},
      "confirm": {"en": "Replace this VM's vm.toml? Its next start boots as it says.", "ru": "Заменить vm.toml? Следующий запуск будет по нему."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "text": {"type": "text", "required": true, "title": {"en": "The file", "ru": "Файл"}}}},
    "forward_add": {"kind": "action", "title": {"en": "Forward a port", "ru": "Пробросить порт"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "port": {"type": "port", "required": true, "title": {"en": "nos's port", "ru": "Порт nos"}},
        "guest_port": {"type": "port", "required": true, "title": {"en": "The guest's port", "ru": "Порт гостя"}}}},
    "forward_del": {"kind": "action", "title": {"en": "Remove a forward", "ru": "Убрать проброс"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "port": {"type": "port", "required": true, "title": {"en": "nos's port", "ru": "Порт nos"}}}},
    "console_write": {"kind": "action", "title": {"en": "Type at the console", "ru": "Ввод в консоль"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "text": {"type": "text", "required": true, "title": {"en": "Text", "ru": "Текст"}}}},
    "disk_add": {"kind": "action", "title": {"en": "Add a disk", "ru": "Добавить диск"},
      "help": {"en": "A new empty disk in its folder, read at its next start.", "ru": "Новый пустой диск в её папке; виден со следующего запуска."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "file": {"type": "string", "required": true, "title": {"en": "File", "ru": "Файл"}},
        "size_bytes": {"type": "bytes", "min": 1048576, "required": true, "title": {"en": "Size", "ru": "Размер"}}}},
    "disk_grow": {"kind": "action", "title": {"en": "Grow a disk", "ru": "Увеличить диск"},
      "confirm": {"en": "Grow this disk? It is never shrunk.", "ru": "Увеличить диск? Уменьшить его потом нельзя."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "file": {"type": "string", "required": true, "title": {"en": "File", "ru": "Файл"}},
        "size_bytes": {"type": "bytes", "min": 1, "required": true, "title": {"en": "Size", "ru": "Размер"}}}},
    "disk_attach": {"kind": "action", "title": {"en": "Give to a VM", "ru": "Отдать машине"},
      "help": {"en": "A stopped VM's disk from its next start.", "ru": "Диск остановленной машины со следующего запуска."},
      "confirm": {"en": "The guest writes over what is on it. Give it?", "ru": "Гость будет писать поверх данных. Отдать?"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "VM", "ru": "Машина"}},
        "device": {"type": "string", "required": true, "title": {"en": "Device", "ru": "Устройство"}},
        "read_only": {"type": "bool", "title": {"en": "Read-only", "ru": "Только чтение"}},
        "force": {"type": "bool", "title": {"en": "Over what is on it", "ru": "Поверх данных"}}}},
    "disk_detach": {"kind": "action", "title": {"en": "Take off the VM", "ru": "Забрать у машины"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "VM", "ru": "Машина"}},
        "device": {"type": "string", "required": true, "title": {"en": "Device", "ru": "Устройство"}}}},
    "pci_attach": {"kind": "action", "title": {"en": "Give to a VM", "ru": "Отдать машине"},
      "help": {"en": "A stopped VM's from its next start: never one that cannot be given.", "ru": "Остановленной машине со следующего запуска; функцию, которую нельзя отдать, -- никогда."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "VM", "ru": "Машина"}},
        "address": {"type": "string", "required": true, "title": {"en": "Function", "ru": "Функция"}}}},
    "pci_detach": {"kind": "action", "title": {"en": "Take off the VM", "ru": "Забрать у машины"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "VM", "ru": "Машина"}},
        "address": {"type": "string", "required": true, "title": {"en": "Function", "ru": "Функция"}}}},
    "snapshot": {"kind": "action", "title": {"en": "Snapshot", "ru": "Снимок"},
      "help": {"en": "A snapshot of its disk that is a volume of NBS's -- its first, or the one named: read-only and thin, the disk as it is now; a running VM's as a power cut would leave it. VMs are made of it as of an image.", "ru": "Снимок её диска-тома NBS -- первого или указанного: только для чтения, тонкий, диск таким, какой он сейчас; у работающей машины -- каким его оставило бы отключение питания. Машины создаются из него, как из образа."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "VM", "ru": "Машина"}},
        "snapshot": {"type": "string", "required": true, "title": {"en": "Snapshot's name", "ru": "Имя снимка"},
          "help": {"en": "Lowercase letters, digits, . _ and -.", "ru": "Строчные буквы, цифры, . _ и -."}},
        "disk": {"type": "string", "title": {"en": "Its disk", "ru": "Её диск"},
          "help": {"en": "nbs:<volume>, one of its disks; its first when none is given.", "ru": "nbs:<том>, один из её дисков; если не указан -- первый."}}}},
    "start": {"kind": "job", "title": {"en": "Start", "ru": "Запустить"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}}}},
    "stop": {"kind": "job", "title": {"en": "Stop", "ru": "Остановить"},
      "confirm": {"en": "Stop this VM? Its power button is pressed first.", "ru": "Остановить машину? Сначала нажимается кнопка питания."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "secs": {"type": "int", "min": 0, "max": 600, "default": 30, "title": {"en": "Seconds to shut down", "ru": "Секунд на выключение"}},
        "force": {"type": "bool", "title": {"en": "Even if protected", "ru": "Даже защищённую"}}}},
    "restart": {"kind": "job", "title": {"en": "Restart", "ru": "Перезапустить"},
      "confirm": {"en": "Restart this VM, as a reset button would?", "ru": "Перезапустить машину, как кнопкой reset?"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "force": {"type": "bool", "title": {"en": "Even if protected", "ru": "Даже защищённую"}}}},
    "create": {"kind": "job", "title": {"en": "Create from an image", "ru": "Создать из образа"},
      "help": {"en": "A cloud's image, qcow2 or raw, downloaded and made the VM's disk -- or an image of NBS's, cloned for it.", "ru": "Облачный образ, qcow2 или raw, скачивается и становится диском машины -- или клон образа NBS."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "url": {"type": "string", "title": {"en": "Image URL", "ru": "URL образа"}},
        "image": {"type": "string", "title": {"en": "NBS image", "ru": "Образ NBS"},
          "help": {"en": "An image or a snapshot of NBS's, in place of a URL: its clone the VM's disk.", "ru": "Образ или снимок NBS вместо URL: его клон становится диском машины."}},
        "size_bytes": {"type": "bytes", "title": {"en": "Disk size", "ru": "Размер диска"}},
        "memory_mib": {"type": "int", "min": 64, "unit": "MiB", "default": 1024, "title": {"en": "Memory", "ru": "Память"}},
        "cpus": {"type": "int", "min": 1, "default": 1, "title": {"en": "CPUs", "ru": "Процессоры"}},
        "node": {"type": "int", "min": 0, "max": 15, "title": {"en": "NUMA node", "ru": "Узел NUMA"},
          "help": {"en": "The NUMA node its CPUs are placed on and its memory taken from, on a machine of more than one (system.numa). Where its first CPU falls when not given.",
                   "ru": "Узел NUMA, на процессорах которого она работает и из памяти которого берёт свою, если узлов больше одного (system.numa). Если не задан, там, где окажется её первый процессор."}},
        "network": {"type": "string", "title": {"en": "Network", "ru": "Сеть"},
          "help": {"en": "A host's network its VMs share, or one of the cluster's, vnet:<name> -- its port, address and firewall vnet's.", "ru": "Сеть хоста, общая для её машин, или сеть кластера, vnet:<имя> -- порт, адрес и фаервол машины тогда держит vnet."},
          "choices": {"provider": "vm", "method": "networks", "items": "networks", "key": "name"}},
        "firewall": {"type": "string", "title": {"en": "Firewall", "ru": "Фаервол"},
          "help": {"en": "What its network is judged by; default -- what comes in denied, what goes out allowed -- when none is given. On a network of the cluster's, one of the cluster's.", "ru": "Чем судится её сеть; если не указан -- default: входящее закрыто, исходящее открыто. В сети кластера -- фаервол кластера."},
          "choices": {"provider": "fw", "method": "list", "items": "firewalls", "key": "name"}},
        "public": {"type": "ipv4", "title": {"en": "Public address", "ru": "Публичный адрес"},
          "help": {"en": "An address of the world's routed to this host -- a rented one -- mapped one to one to the VM: reached there at the ports its firewall opens, and going out from it.", "ru": "Адрес из интернета, направленный на этот хост (арендованный), отображается на машину один к одному: к ней приходят по нему на порты, которые открывает её фаервол, и она выходит наружу с него."}},
        "password": {"type": "string", "title": {"en": "Password of the image's user", "ru": "Пароль пользователя образа"},
          "help": {"en": "cloud-init gives it to the image's default user -- ubuntu, debian, alpine...: root stays locked", "ru": "cloud-init задаёт его пользователю образа по умолчанию -- ubuntu, debian, alpine...: root остаётся закрыт"}},
        "user_data": {"type": "text", "title": {"en": "cloud-init user-data", "ru": "user-data для cloud-init"}},
        "port": {"type": "int", "min": 0, "max": 15, "title": {"en": "Switch port of its own", "ru": "Свой порт коммутатора"},
          "help": {"en": "Its address the same at every start.", "ru": "Адрес машины одинаков при каждом запуске."}},
        "forwards": {"type": "list", "of": "string", "title": {"en": "Forwards, nos's port:the guest's", "ru": "Пробросы, порт nos:порт гостя"}},
        "protected": {"type": "bool", "title": {"en": "Protected", "ru": "Защищённая"},
          "help": {"en": "Stopped and deleted only when told force.", "ru": "Останавливается и удаляется только с force."}},
        "start": {"type": "bool", "title": {"en": "Start once made", "ru": "Запустить после создания"}},
        "onto": {"type": "string", "title": {"en": "Onto a device", "ru": "На устройство"},
          "help": {"en": "A partition or disk of nos's, or nbs:<volume>, in place of a file; an image's clone's name.", "ru": "Раздел или диск nos либо nbs:<том> вместо файла; для образа NBS -- имя клона."}},
        "force": {"type": "bool", "title": {"en": "Over what is on it", "ru": "Поверх данных"}}}},
    "clone": {"kind": "job", "title": {"en": "Clone", "ru": "Клонировать"},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "to": {"type": "string", "required": true, "title": {"en": "New name", "ru": "Новое имя"}},
        "port": {"type": "int", "min": 0, "max": 15, "title": {"en": "Switch port", "ru": "Порт коммутатора"}}}},
    "delete": {"kind": "job", "title": {"en": "Delete", "ru": "Удалить"},
      "confirm": {"en": "This VM and its disks are deleted, and cannot be brought back. Type its name to go on.", "ru": "Машина и её диски будут удалены без возможности вернуть. Введите её имя, чтобы продолжить."},
      "confirm_typed": "name",
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "keep_disks": {"type": "bool", "title": {"en": "Keep its disks", "ru": "Оставить диски"}},
        "force": {"type": "bool", "title": {"en": "Even if protected", "ru": "Даже защищённую"}}}},
    "image": {"kind": "job", "title": {"en": "New image", "ru": "Новый образ"},
      "help": {"en": "An image of NBS's made of a cloud's image, qcow2 or raw, by its URL -- or of a file of nos's: a volume of its disk's size, the image poured onto it, frozen read-only. VMs are made of clones of it.", "ru": "Образ NBS из облачного образа (qcow2 или raw) по URL -- или из файла nos: том размером с его диск, образ записывается в него и замораживается только для чтения. Машины создаются из его клонов."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"},
          "help": {"en": "Lowercase letters, digits, . _ and -.", "ru": "Строчные буквы, цифры, . _ и -."}},
        "from": {"type": "string", "required": true, "title": {"en": "URL or file", "ru": "URL или файл"},
          "help": {"en": "An http:// or https:// URL, or a file of nos's by its path.", "ru": "URL http:// или https://, либо путь к файлу nos."}}}},
    "migrate": {"kind": "job", "title": {"en": "Move to another host", "ru": "Перенести на другой хост"},
      "help": {"en": "A running VM moved to another host of the cluster's, its memory copied as it runs and paused for the last of it -- its disks volumes of NBS's, its network the cluster's. A cancel before the last round's end leaves it running here.", "ru": "Работающая машина переезжает на другой хост кластера: память копируется на ходу, на последнюю часть машина приостанавливается. Её диски -- тома NBS, сеть -- сеть кластера. Отмена до конца последнего раунда оставляет её работать здесь."},
      "confirm": {"en": "Move this VM to the host chosen? It pauses for a moment at the end.", "ru": "Перенести машину на выбранный хост? В конце она на мгновение приостановится."},
      "params": {"name": {"type": "string", "required": true, "title": {"en": "Name", "ru": "Имя"}},
        "host": {"type": "string", "required": true, "title": {"en": "Host", "ru": "Хост"},
          "choices": {"provider": "cluster", "method": "hosts", "items": "hosts", "key": "name"}},
        "cold": {"type": "bool", "title": {"en": "Paused for the whole copy", "ru": "Остановить на всё копирование"}}}}
  },
  "resources": {
    "vms": {
      "title": {"en": "VMs", "ru": "Машины"},
      "list": "list", "get": "get", "items": "vms", "key": "name",
      "fields": {
        "name": {"type": "string", "title": {"en": "Name", "ru": "Имя"}},
        "state": {"type": "enum", "title": {"en": "State", "ru": "Состояние"}, "values": {
          "running": {"en": "running", "ru": "работает"},
          "stopping": {"en": "stopping", "ru": "останавливается"},
          "moving": {"en": "moving", "ru": "переносится"},
          "saving": {"en": "saving", "ru": "сохраняется"},
          "stopped": {"en": "stopped", "ru": "остановлена"},
          "off": {"en": "off", "ru": "выключена"},
          "busy": {"en": "busy", "ru": "занята"}}},
        "cpus": {"type": "int", "title": {"en": "CPUs", "ru": "ЦП"}},
        "memory_mib": {"type": "int", "unit": "MiB", "title": {"en": "Memory", "ru": "Память"}},
        "node": {"type": "int", "title": {"en": "NUMA node", "ru": "Узел NUMA"}},
        "node_memory_pct": {"type": "int", "unit": "%", "title": {"en": "Memory on its node", "ru": "Памяти на своём узле"}},
        "ip": {"type": "ipv4", "title": {"en": "Address", "ru": "Адрес"}},
        "firewall": {"type": "string", "title": {"en": "Firewall", "ru": "Фаервол"}},
        "public": {"type": "ipv4", "title": {"en": "Public address", "ru": "Публичный адрес"}},
        "uptime_ms": {"type": "duration_ms", "title": {"en": "Up", "ru": "Работает"}},
        "restarts": {"type": "int", "title": {"en": "Restarts", "ru": "Перезапуски"}},
        "protected": {"type": "bool", "title": {"en": "Protected", "ru": "Защищена"}},
        "exits": {"type": "int", "title": {"en": "Exits", "ru": "Выходы"}}
      },
      "columns": ["name", "state", "cpus", "memory_mib", "ip", "uptime_ms"],
      "actions": [{"method": "start", "params": {"name": "$name"}}, {"method": "stop", "params": {"name": "$name"}},
        {"method": "restart", "params": {"name": "$name"}}, {"method": "clone", "params": {"name": "$name"}},
        {"method": "migrate", "params": {"name": "$name"}}, {"method": "delete", "params": {"name": "$name"}}]
    },
    "disks": {
      "title": {"en": "Disks", "ru": "Диски"},
      "list": "disks", "items": "disks", "key": "file", "parent": "vms",
      "fields": {
        "file": {"type": "string", "title": {"en": "File", "ru": "Файл"}},
        "size_bytes": {"type": "bytes", "title": {"en": "Size", "ru": "Размер"}},
        "read_only": {"type": "bool", "title": {"en": "Read-only", "ru": "Только чтение"}},
        "device": {"type": "bool", "title": {"en": "Device", "ru": "Устройство"}},
        "device_name": {"type": "string", "title": {"en": "Device's name", "ru": "Имя устройства"}},
        "vm": {"type": "string", "title": {"en": "VM", "ru": "Машина"}}
      },
      "columns": ["file", "size_bytes", "read_only", "device_name"],
      "actions": [{"method": "disk_grow", "params": {"name": "$vm", "file": "$file"}},
        {"method": "disk_detach", "params": {"name": "$vm", "device": "$file"}}]
    },
    "devices": {
      "title": {"en": "Devices", "ru": "Устройства"},
      "list": "devices", "items": "devices", "key": "name",
      "fields": {
        "name": {"type": "string", "title": {"en": "Name", "ru": "Имя"}},
