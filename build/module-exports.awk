# The kernel's module export table (kernel/module.cpp), written as assembly:
# given the names of the functions to export, one per line, an array of
# { name, address } pairs and its length, for the linker to fill in the
# addresses of. The Makefile's module_exports.S rule feeds it.
BEGIN {
    print "/* generated by the Makefile from build/module-exports.awk; do not edit */"
    print "    .section .rodata.nos_module_exports, \"a\""
    print "    .balign 8"
    print "    .globl nos_module_exports"
    print "nos_module_exports:"
}

{
    name[NR] = $0
    printf "    .quad .Lname%d, %s\n", NR, $0
}

END {
    print "    .globl nos_module_export_count"
    print "nos_module_export_count:"
    printf "    .quad %d\n", NR
    for (i = 1; i <= NR; i++)
        printf ".Lname%d:\n    .asciz \"%s\"\n", i, name[i]
}
