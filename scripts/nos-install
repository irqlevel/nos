#!/bin/bash
# nos-install: pour a nos system image onto a partition of this machine and
# boot nos from it through this machine's own GRUB -- or onto a whole disk,
# which then boots nos alone (docs/install.md).
#
#   nos-install install <partition> [options]    put the image on <partition>
#   nos-install disk <disk> [options]            make <disk> nos's own
#   nos-install disks                            the disks here, for disk
#   nos-install network [--toml]                 this Linux's network, as
#                                                --network-here gives it nos;
#                                                --toml prints every interface's
#                                                settings, not just the default's
#   nos-install update [<partition>] [options]   a new image over the one there
#   nos-install rollback [<partition>]           back to the image before it
#   nos-install boot [<partition>] [--reboot]    boot nos once, the next time
#   nos-install boot --default                   a disk of nos's own the
#                                                firmware's boot, for good
#   nos-install status [<partition>]             what is installed and armed
#   nos-install uninstall                        take nos out of GRUB's menu
#
# Options of disk, besides install's (but --format and --boot-once):
#   --root-size SIZE      nos's root: 10G unless given (M, G or T; "all" for
#                         the whole disk). The rest of the disk is left as a
#                         partition with nothing on it, nos-data: for the
#                         VMs' disks and NBS
#   --wipe                erase what the disk holds -- a partition table, a
#                         filesystem, any data: refused without it
#   --dry-run             check everything, say what would be written, and
#                         write nothing
#   --keep-boot-order     leave the firmware's boot order as it is (UEFI): put
#                         otherwise, the disk's entry first after the network's
#
# Options of install and update:
#   --image FILE          the image (nos-x86_64.squashfs); by default the one
#                         this script is in, mounted
#   --format              a new filesystem on the partition even when it has
#                         one: everything on it is lost
#   --ssh-key KEY         a key sshd lets in, as a .pub file or as the line
#                         itself; ssh-ed25519 only; may be given more than once
#   --udpshell[=PORT]     the shell over UDP, on PORT (9000): anyone who can
#                         send this machine a datagram runs commands in its
#                         kernel. Off unless asked for
#   --netconsole IP:PORT  the kernel log, over UDP, to IP:PORT
#   --cmdline "ARGS"      more kernel parameters (docs/kernel-parameters.md);
#                         not ip=, gw=, dns= or dhcp=, which are the options
#                         below
#   --ip A.B.C.D/N        nos's address on its network and the prefix length,
#                         for a network with no DHCP server; with
#   --gw A.B.C.D          its gateway, another address of that subnet, and
#   --dns A.B.C.D         the DNS server nos asks (with --dhcp, or neither,
#                         the one it asks in place of the DHCP lease's)
#   --dhcp                nos's address by DHCP, at every boot
#   --network-here        every supported NIC's static address or DHCP, the
#                         default route, additional routes and DNS server as
#                         this Linux has them now, mapped by nos's PCI order
#   --panel               the management panel: a VM of nos's that manages it
#                         in a browser, at https://<this machine>:39233, as
#                         root -- with a password made now and printed once.
#                         nos makes the VM at its first boot, of Debian's
#                         cloud image and the panel's bundle, both downloaded
#                         (docs/api.md). /etc/rc is given its lines
#   --no-panel            /etc/rc without `api panel create`: the panel's VM
#                         is neither made nor started at boot
#   --nbs                 NBS prepared on every boot: ipcnet, the cluster
#                         registry and both NBS modules. No cluster is made and
#                         no device added: do that in the panel after the hosts
#                         have joined; volumes take three hosts (docs/nbs.md)
#   --nbs-host NAME       this host's name in the cluster: lowercase letters,
#                         digits and -, up to 63 (this Linux's hostname,
#                         sanitized, unless given). Only with --nbs
#   --no-nbs              /etc/rc without NBS's lines; /etc/ipc is kept
#   --boot-once           boot nos once, the next time
#   --reboot              and reboot now
#
# --udpshell, --netconsole and --cmdline set the kernel parameters this
# machine boots nos with; update keeps the ones it had unless given any of
# them, which then replace the lot (--cmdline "" clears them).
#
# --ip, --gw, --dns, --dhcp and --network-here write /etc/net.toml on the
# root: every interface's settings, which nos reads at every boot (docs/install.md).
# install and disk write one whatever they are given -- DHCP where none of
# them is -- and update keeps the one there unless given any of them; an
# update of an install from before the file writes it from the ip=, gw=,
# dns= and dhcp= its kernel parameters had.
#
# <partition> is named on install; afterwards the GRUB entry names it
# (/etc/grub.d/42_nos). Runs under Linux, as root, on the machine itself.
#
# Disk makes a whole disk nos's, the server's own system gone or elsewhere:
# what an installer from an ISO or a provider's rescue system runs. A GPT --
# GRUB's core image for BIOS, an EFI System partition, nos's root, the rest
# blank -- and GRUB installed onto it for BIOS and for UEFI both (the EFI
# one at the path firmware boots with no boot entry), with a grub.cfg of its
# own on the root that boots nos by default. Nothing of this machine's own
# GRUB is touched. Under UEFI the firmware's entry for the disk goes first
# after the network's (a provider's PXE stays first, for its rescue system),
# so the server boots nos rather than the system it had. Update, rollback,
# boot and status find such a root by itself (or take it named); boot is
# the firmware's next boot (BootNext), --default its order; uninstall has
# nothing to take out.
#
# Install pours the image onto a plain partition as an ext4 filesystem --
# or the ext2 one an install before ext4 made, kept as it is -- that
# nos mounts read-write as its root -- the kernel in /boot, the modules built
# with it in /lib/modules, hvboot and the CloudHv firmware in /lib, /etc/rc,
# the grubenv -- and adds
# the entry to this machine's GRUB that boots it. The machine's default does
# not change: nos boots once when asked (boot, --boot-once), and the boot
# after that is the default again, so a nos that never comes up is a reset
# away from it.
#
# For a test: NOS_EFIBOOTMGR in place of efibootmgr, NOS_FIRMWARE (uefi or
# bios) and NOS_IN_VM (0 or 1) for what this machine is,
# NOS_GRUB_D in place of /etc/grub.d, NOS_UPDATE_GRUB in place of
# update-grub (true: nothing), NOS_ALLOW_ANY_DISK=1 not to ask what the
# partition's disk is, NOS_CPUINFO and NOS_UCODE_DIR in place of /proc/cpuinfo
# and /lib/firmware/intel-ucode.

set -euo pipefail
# A failure inside $(...) is a failure too (bash 4.4 and later)
shopt -s inherit_errexit 2>/dev/null || true
# Under pipefail a reader that leaves a pipe early -- grep -q at its match --
# makes the writer's SIGPIPE the pipeline's answer: a "no" for what was
# there, whenever the writer had more to write after it, as efibootmgr 18
# has, which writes its listing an entry at a time. So what a command
# prints is read whole, into a variable, and only then looked at
umask 022
export LC_ALL=C

GRUB_D=${NOS_GRUB_D:-/etc/grub.d}
SNIPPET=$GRUB_D/42_nos
LABEL=nos
UDPSHELL_DEFAULT_PORT=9000
# The kernel reads 255 characters of its command line, and nos.cfg puts
# "root=UUID=<36> dhcp=auto dns=on " in front of what is kept here
CMDLINE_MAX=191
# What nos's ext2 reads and writes (docs/filesystems.md): any other feature
# is a filesystem it mounts read-only, or not at all
EXT2_FEATURES_OK=" ext_attr resize_inode dir_index filetype sparse_super large_file "
# What a new filesystem is made with, named from none -- so that this
# machine's mke2fs.conf adds nothing: not orphan_file or metadata_csum_seed,
# which nos mounts read-only and GRUB 2.06 cannot read -- and what an ext4
# may have that nos writes: the same, and needs_recovery, which a replay
# clears (scripts/mkrootfs.sh and scripts/build-disk.sh make the same)
EXT4_FEATURES=none,has_journal,ext_attr,resize_inode,dir_index,filetype,extent,64bit,flex_bg,sparse_super,large_file,huge_file,dir_nlink,extra_isize,metadata_csum
EXT4_FEATURES_OK=" has_journal ext_attr resize_inode dir_index filetype extent 64bit flex_bg sparse_super large_file huge_file dir_nlink extra_isize metadata_csum needs_recovery "
# What of an image goes where. The system is replaced whole by an update,
# and what it replaces is kept as .prev, all of it together, for rollback:
# the kernel, the modules built with it, hvboot -- the loader hv boots a
# guest's own kernel with (docs/hypervisor.md) -- and the CloudHv firmware,
# which an image older than them does not have, and the VERSION that names
# them, last. GRUB's entries are
# replaced, /etc/rc goes in the first time only, and nos-install and
# nos-setup (the installer's dialog, run from the image in a provider's
# rescue system) stay in the image. An image holding anything else is
# refused: poured, that part would be left out without a word, as
# /lib/hvboot was by v0.0.26's own nos-install, so a file the image gains
# is added here too. /lib/licenses
# holds the notices of the code the kernel, its modules and the firmware
# carry, and goes with them
SYSTEM="boot/kernel64.elf lib/modules lib/hvboot lib/CLOUDHV.fd lib/panel lib/licenses VERSION"
LAYOUT=" $SYSTEM lib/panel/bundle lib/licenses/CRYPTOGAMS lib/licenses/CLOUDHV boot/grub/nos.cfg etc/rc nos-install nos-setup boot boot/grub etc lib "
# The management panel's lines of /etc/rc (--panel): hv and the host API,
# then the panel's VM -- made at the first boot, started at every one after
PANEL_RC=(
    "insmod /lib/modules/hv.ko"
    "hv on"
    "insmod /lib/modules/api.ko"
    "api start"
    "api panel create"
)
# root's password for the panel, as scrypt hashed it: what `api panel create`
# hands the panel (panel/src/lib/auth.ts checks it), N=2^15, r=8, p=1
PANEL_PASS=etc/api/panel.pass
PANEL_PORT=39233
# NBS's lines of /etc/rc (--nbs): every host prepared alike. hosts.toml has
# this host's identity already, so nothing here is a one-shot init. Creating
# or joining the registry and NBS clusters, and adding devices, is the panel's.
NBS_RC=(
    "insmod /lib/modules/ipcnet.ko"
    "ipcnet start"
    "insmod /lib/modules/cluster.ko"
    "insmod /lib/modules/nbs-mds.ko"
    "insmod /lib/modules/nbs-cs.ko"
)
# A disk of nos's own (disk): GPT's partition types
GPT_BIOS_BOOT=21686148-6449-6E6F-744E-656564454649
GPT_ESP=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
GPT_LINUX=0FC63DAF-8483-4772-8E79-3D69D8477DE4
# ... and its layout, in MiB: a MiB left for the GPT, GRUB's core image for
# BIOS, the EFI System partition, nos's root, then the rest -- where it is
# worth a partition -- and a MiB at the end for the GPT's copy
MIB=1048576
BIOS_BOOT_MIB=1
ESP_MIB=512
ROOT_SIZE_DEFAULT=10G
ROOT_MIN_MIB=256
DATA_MIN_MIB=1024
ESP_LABEL=NOS-EFI
DATA_NAME=nos-data
# The first line of the grub.cfg disk writes on the root: what says a root
# is a disk of nos's own, whose GRUB boots nothing else
STANDALONE_MARK="# nos: this disk's own GRUB configuration, written by nos-install disk"

die() { echo "nos-install: $*" >&2; exit 1; }
warn() { echo "nos-install: WARNING: $*" >&2; }
say() { echo "nos-install: $*"; }

usage() {
    sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
    exit "${1:-2}"
}

# Mount points this run made (unmounted, then removed when empty) and
# scratch directories (removed whole; never a mount point)
MOUNT_DIRS=()
TEMP_DIRS=()
cleanup() {
    local i
    for (( i = ${#MOUNT_DIRS[@]} - 1; i >= 0; i-- )); do
        if umount "${MOUNT_DIRS[i]}" 2>/dev/null || ! mountpoint -q "${MOUNT_DIRS[i]}"; then
            rmdir "${MOUNT_DIRS[i]}" 2>/dev/null || true
        else
            warn "could not unmount ${MOUNT_DIRS[i]}"
        fi
    done
    for i in ${TEMP_DIRS[@]+"${TEMP_DIRS[@]}"}; do
        rm -rf "$i"
    done
}
trap cleanup EXIT

need() {
    local missing= t
    for t in "$@"; do
        command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
    done
    [ -z "$missing" ] || die "this needs$missing"
}

# GRUB's own tool for its environment block, under either of its names
EDITENV=
need_editenv() {
    if command -v grub-editenv >/dev/null 2>&1; then
        EDITENV=grub-editenv
    elif command -v grub2-editenv >/dev/null 2>&1; then
        EDITENV=grub2-editenv
    else
        die "no grub-editenv: GRUB's tools are not installed"
    fi
}

editenv() {
    [ -n "$EDITENV" ] || need_editenv
    "$EDITENV" "$@"
}

# ---- the image ---------------------------------------------------------

IMAGE=
IMG=

open_image() {
    if [ -n "$IMAGE" ]; then
        [ -f "$IMAGE" ] || die "no image at $IMAGE"
        local dir
        dir=$(mktemp -d /tmp/nos-image.XXXXXX)
        if mount -t squashfs -o loop,ro "$IMAGE" "$dir" 2>/dev/null; then
            MOUNT_DIRS+=("$dir")
            IMG=$dir
        elif command -v unsquashfs >/dev/null 2>&1; then
            rmdir "$dir"
            dir=$(mktemp -d /tmp/nos-image.XXXXXX)
            TEMP_DIRS+=("$dir")
            unsquashfs -no-progress -d "$dir/root" "$IMAGE" >/dev/null ||
                die "cannot unpack $IMAGE"
            IMG=$dir/root
        else
            rmdir "$dir"
            die "cannot open $IMAGE: no squashfs mount here, and no unsquashfs"
        fi
    else
        IMG=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
    fi

    [ -f "$IMG/VERSION" ] && [ -f "$IMG/boot/kernel64.elf" ] &&
        [ -d "$IMG/lib/modules" ] && [ -f "$IMG/boot/grub/nos.cfg" ] ||
        die "$IMG is not a nos image: run the nos-install in a mounted image, or give --image"

    local arch
    arch=$(version_of "$IMG/VERSION" arch)
    [ "$arch" = "$(uname -m)" ] ||
        die "the image is for ${arch:-an unknown machine}, this machine is $(uname -m)"

    local p unknown=
    while IFS= read -r p; do
        case "$LAYOUT" in
            *" $p "*) ;;
            *) unknown="$unknown /$p" ;;
        esac
    done < <(cd "$IMG" && find . -mindepth 1 -path ./lib/modules -prune -o -print | sed 's|^\./||')
    [ -z "$unknown" ] ||
        die "the image has$unknown, which this nos-install would leave out: run the nos-install in that image"
}

# A value of a VERSION file: version, revision, arch, module_abi
version_of() {
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -n 1
}

describe() {
    if [ -f "$1" ]; then
        echo "nos $(version_of "$1" version) ($(version_of "$1" revision))"
    else
        echo "none"
    fi
}

# ---- the partition -----------------------------------------------------

PART=

check_partition() {
    local dev=$1 name sys holders
    [ -b "$dev" ] || die "$dev is not a block device"
    name=$(basename "$(readlink -f "$dev")")
    sys=/sys/class/block/$name
    [ -d "$sys" ] || die "$dev: no $sys"

    holders=$(ls -A "$sys/holders" 2>/dev/null || true)
    [ -z "$holders" ] ||
        die "$dev is in use by $holders (RAID, LVM, device mapper): nos reads none of them, it needs a plain partition"

    if [ -n "$(blkid -p -o value -s PTTYPE "$dev" 2>/dev/null || true)" ] ||
        [ "$(lsblk -nro NAME "$dev" 2>/dev/null | wc -l)" -gt 1 ]; then
        die "$dev is a disk with partitions on it: name one of them"
    fi

    case "$(findmnt -rno TARGET --source "$dev" 2>/dev/null | head -n 1)" in
        /|/boot|/boot/efi|/usr|/var|/home) die "$dev is one of this system's own filesystems" ;;
    esac
}

# What keeps nos from reading $1, said in a line -- nothing when its
# controller is one nos drives: NVMe, virtio, and SATA in IDE mode or behind
# AHCI
disk_controller_problem() {
    local dev=$1 path pci class
    [ "${NOS_ALLOW_ANY_DISK:-0}" != 1 ] || return 0
    path=$(readlink -f "/sys/class/block/$(basename "$(readlink -f "$dev")")")
    case "$path" in
        */nvme/*|*/virtio*) ;;
        */ata[0-9]*/*)
            # nos's ata driver takes a disk behind a PCI IDE controller --
            # class 0101: SATA in IDE mode, as a BIOS may leave an ICH, or
            # parallel ATA -- and its ahci driver one behind an AHCI HBA
            # (0106, interface 01); not one behind a RAID controller (0104).
            # The controller is the last PCI function on the device's path.
            pci=$(printf '%s\n' "$path" | grep -o '/[0-9a-f]\{4\}:[0-9a-f]\{2\}:[0-9a-f]\{2\}\.[0-7]' | tail -n 1 || true)
            class=$(cat "/sys/bus/pci/devices$pci/class" 2>/dev/null || true)
            case "$class" in
                0x0101*|0x010601) ;;
                *) echo "$dev is on a SATA controller nos does not drive (PCI class ${class:-unknown}: RAID, where nos takes IDE mode and AHCI)" ;;
            esac ;;
        *) echo "$dev is not on an NVMe, a virtio or a SATA disk (IDE mode or AHCI), which is all nos reads" ;;
    esac
}

# The PCI addresses of the network cards nos drives, in the bus's order --
# the order nos names them in, so the first is its eth0, which ip= is for.
# The parts its drivers claim: drivers/net/r8168, drivers/net/r8125,
# drivers/net/igb (82576, I210/I211, I350), drivers/net/e1000e, virtio-net
nos_nics() {
    local d id
    for d in /sys/bus/pci/devices/*; do
        [ -r "$d/vendor" ] || continue
        id=$(cat "$d/vendor"):$(cat "$d/device")
        case "$id" in
            0x10ec:0x8168|0x10ec:0x8125|\
            0x8086:0x10c9|0x8086:0x10e8|0x8086:0x150a|\
            0x8086:0x1533|0x8086:0x1536|0x8086:0x1537|0x8086:0x1538|\
            0x8086:0x1539|0x8086:0x157b|0x8086:0x157c|\
            0x8086:0x1521|\
            0x8086:0x10d3|\
            0x1af4:0x1000|0x1af4:0x1041)
                basename "$d" ;;
        esac
    done | sort
}

# Warnings, not refusals: GRUB boots nos from anything the firmware reads,
# but what nos does after that depends on what it has drivers for. A disk
# that is to be nos's own ("disk" as the second argument) is refused,
# though: its root there is all nos would have
check_hardware() {
    local dev=$1 mode=${2:-partition} problem d id found=
    problem=$(disk_controller_problem "$dev")
    if [ -n "$problem" ]; then
        problem="$problem: GRUB will load the kernel from it, but nos will not find its root on it -- no modules, no /etc/rc, no sshd"
        if [ "$mode" = disk ]; then
            die "$problem"
        fi
        warn "$problem"
    fi

    # The network is a server's only console
    found=$(nos_nics)
    [ -n "$found" ] ||
        warn "no network card here that nos has a driver for (RTL8168, RTL8125, Intel 82576/I210/I211/I350, Intel 82574L, virtio-net): booted, nos cannot be reached"

    if [ -d /sys/firmware/efi ]; then
        local sb
        sb=$(od -An -t u1 -j 4 -N 1 \
            /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c 2>/dev/null | tr -d ' ' || true)
        [ "$sb" != 1 ] ||
            warn "Secure Boot is on: GRUB will not load nos (multiboot2 under lockdown) -- turn it off in the firmware"
    fi
}

# The filesystem on $1, of type $2 (ext2 or ext4), one nos writes: every
# feature it has one nos's driver for it writes
check_fs() {
    local feats f bad= ok
    case "$2" in
        ext2) ok=$EXT2_FEATURES_OK ;;
        ext4) ok=$EXT4_FEATURES_OK ;;
        *) die "$1 has a $2 filesystem on it, which nos does not take" ;;
    esac
    feats=$(dumpe2fs -h "$1" 2>/dev/null | sed -n 's/^Filesystem features:[[:space:]]*//p')
    [ -n "$feats" ] || die "cannot read the $2 superblock of $1"
    for f in $feats; do
        case "$ok" in
            *" $f "*) ;;
            *) bad="$bad $f" ;;
        esac
    done
    [ -z "$bad" ] ||
        die "$1 has filesystem features nos cannot write:$bad -- --format makes a new filesystem there"
    case " $feats " in
        *" filetype "*) ;;
        *) die "$1 has no filetype feature, which nos needs -- --format makes a new filesystem there" ;;
    esac
}

MNT=
MOUNTED_HERE=0

# e2fsck before a write as well as after: what is found after should be
# what the write did, not what was there. A filesystem mounted elsewhere
# cannot be checked, and is not. A journal that needs replaying -- nos
# stopped without unmounting -- is replayed first, its orphans released, as
# any mount would: e2fsck -fn looks at what the replay leaves (-y with
# journal_only and no -f replays, and goes no further)
fsck_partition() {
    local dev=$1 when=$2 features
    [ -z "$(findmnt -rno TARGET --source "$dev" 2>/dev/null || true)" ] || return 0
    features=$(dumpe2fs -h "$dev" 2>/dev/null | sed -n 's/^Filesystem features://p' || true)
    if grep -qw needs_recovery <<< "$features"; then
        say "replaying the journal of $dev"
        e2fsck -y -E journal_only "$dev" >/dev/null 2>&1 || true
    fi
    if ! e2fsck -fn "$dev" >/dev/null 2>&1; then
        e2fsck -fn "$dev" >&2 || true
        die "e2fsck finds $dev damaged $when -- e2fsck -f $dev repairs it"
    fi
}

# Mounted where the system has it, or here; "ro" for a look only
mount_partition() {
    local dev=$1 how=${2:-rw} mp options
    mp=$(findmnt -rno TARGET --source "$dev" 2>/dev/null | head -n 1 || true)
    if [ -n "$mp" ]; then
        options=$(findmnt -rno OPTIONS --source "$dev" 2>/dev/null | head -n 1 || true)
        [ "$how" = ro ] || grep -qE '(^|,)rw(,|$)' <<< "$options" ||
            die "$dev is mounted read-only at $mp"
        MNT=$mp
        MOUNTED_HERE=0
    else
        MNT=$(mktemp -d /tmp/nos-part.XXXXXX)
        if ! mount -o "$how" "$dev" "$MNT"; then
            rmdir "$MNT"
            die "cannot mount $dev"
        fi
        MOUNT_DIRS+=("$MNT")
        MOUNTED_HERE=1
    fi
    case "$MNT" in
        ''|/) die "$dev mounted at '$MNT'" ;;
    esac
}

unmount_partition() {
    local dev=$1
    sync -f "$MNT"
    if [ "$MOUNTED_HERE" = 1 ]; then
        umount "$MNT" || die "cannot unmount $dev from $MNT"
        rmdir "$MNT" 2>/dev/null || true
        MOUNTED_HERE=0
    fi
}

# The partition the GRUB entry names
registered_uuid() {
    [ -f "$SNIPPET" ] || return 0
    sed -n 's/^set nos_uuid=\([0-9a-fA-F-]*\)$/\1/p' "$SNIPPET" | head -n 1
}

# The partition named; else the one the GRUB entry names; else, on a
# machine with no entry -- a rescue system's, an installer's -- the root of
# the one disk of nos's own here
resolve_partition() {
    if [ -n "$PART" ]; then
        return
    fi
    local uuid
    uuid=$(registered_uuid)
    if [ -z "$uuid" ]; then
        find_standalone_root
        return
    fi
    PART=$(blkid -U "$uuid" 2>/dev/null || true)
    [ -n "$PART" ] || die "the GRUB entry names UUID $uuid, and no partition has it"
}

# Whether $1 is the root of a disk of nos's own: its grub.cfg is the one
# disk wrote. Read with debugfs, which mounts nothing -- a mount of an ext4
# would replay its journal
is_standalone() {
    command -v debugfs >/dev/null 2>&1 || return 1
    [ "$(debugfs -R "cat /boot/grub/grub.cfg" "$1" 2>/dev/null | head -n 1)" = "$STANDALONE_MARK" ]
}

find_standalone_root() {
    local dev found=()
    while IFS= read -r dev; do
        [ -n "$dev" ] || continue
        if is_standalone "$dev"; then
            found+=("$dev")
        fi
    done < <(blkid -c /dev/null -o device -t LABEL="$LABEL" 2>/dev/null || true)
    case "${#found[@]}" in
        1) PART=${found[0]}
           say "$PART: the root of a disk of nos's own" ;;
        0) die "no partition named, no GRUB entry ($SNIPPET) to take one from, and no disk of nos's own here" ;;
        *) die "more than one disk of nos's own here (${found[*]}): name the partition" ;;
    esac
}

# ---- what goes onto it -------------------------------------------------

KEYS=()

add_ssh_key() {
    local src=$1 text line type blob rest why from= taken=0
    if [ -f "$src" ]; then
        text=$(cat "$src")
        from=$src
    else
        case "$src" in
            ssh-*|ecdsa-*|sk-*) text=$src ;;
            *) die "--ssh-key: no file $src, and it is not a key" ;;
        esac
    fi
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        read -r type blob rest <<<"$line"
        # A file -- an authorized_keys, say -- gives what sshd can take of
        # it, and says what it leaves; a key given as itself is taken whole
        # or refused
        if [ "$type" != ssh-ed25519 ]; then
            case "$type" in
                ssh-*|ecdsa-*|sk-*) why="a $type key: nos's sshd takes ssh-ed25519 only (ssh-keygen -t ed25519)" ;;
                *) why="options in front of the key, which nos's sshd would not honour" ;;
            esac
            [ -n "$from" ] || die "--ssh-key: $why"
            warn "--ssh-key $from: left out $why"
            continue
        fi
        [[ "${blob:-}" =~ ^[A-Za-z0-9+/]+=*$ ]] || die "--ssh-key: not a key: $line"
        KEYS+=("$line")
        taken=$((taken + 1))
    done <<<"$text"
    [ "$taken" -gt 0 ] || die "--ssh-key ${from:-$src}: no ssh-ed25519 key in it"
}

UDPSHELL=
NETCONSOLE=
EXTRA=
SET_CMDLINE=0
CMDLINE=
NETWORK_HERE=0
NETWORK_TOML=0
# The interfaces' settings for /etc/net.toml (--ip, --gw, --dns, --dhcp,
# --network-here): NET_MODE static (NET_IP, with NET_GW), dhcp, manual, or
# multi (NET_MULTI_TOML and NET_DEFAULT) -- and NET_DNS the resolver, given;
# SET_NETWORK 1 where an option says
NET_MODE=
NET_IP=
NET_GW=
NET_DNS=
NET_DEFAULT=eth0
NET_MULTI_TOML=
SET_NETWORK=0
# Where the settings are on the root, and the literal a kernel that reads
# them has in its image (src/crates/layers/net/src/settings.rs, PATH)
NET_TOML=etc/net.toml
NET_TOML_PATH=/etc/net.toml

# The PCI address of network interface $1, or nothing for one on no PCI bus
nic_pci() {
    basename "$(readlink -f "/sys/class/net/$1/device" 2>/dev/null)" 2>/dev/null | grep -E '^[0-9a-f]{4}:' || true
}

# This Linux's supported interfaces as records, in nos's PCI order:
# default|ethN; dns|A.B.C.D; nic|ethN|static|address/prefix|gateway|Linux name;
# nic|ethN|dhcp|address/prefix|router|Linux name; route|ethN|network/prefix|gateway.
# A DHCP lease's current address is in the record for the summary, not written
# as a static one. Every non-default route with a gateway is kept.
network_here_data() {
    local route gw dev addr dns pci first link name mode nicgw target via
    local nics=() i n default_eth= recorded=
    need ip
    route=$(ip -4 route show default 2>/dev/null | head -n 1)
    gw=$(printf '%s\n' "$route" | sed -n 's/.* via \([0-9.]*\).*/\1/p')
    dev=$(printf '%s\n' "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')
    [ -n "$gw" ] && [ -n "$dev" ] || die "--network-here: this Linux has no default route through a gateway"
    addr=$(ip -4 -o addr show dev "$dev" scope global 2>/dev/null | awk '{ print $4; exit }')
    [[ "$addr" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$ ]] || die "--network-here: $dev has no IPv4 address"
    dns=$(awk '$1 == "nameserver" && $2 ~ /^[0-9.]+$/ { print $2; exit }' /etc/resolv.conf 2>/dev/null || true)
    case "$dns" in
        ''|127.*)
            dns=$(awk '$1 == "nameserver" && $2 ~ /^[0-9.]+$/ && $2 !~ /^127\./ { print $2; exit }' \
                /run/systemd/resolve/resolv.conf 2>/dev/null || true)
            [ -n "$dns" ] || dns=$(resolvectl dns "$dev" 2>/dev/null |
                grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1 || true) ;;
    esac
    [ -n "$dns" ] || die "--network-here: no DNS server this Linux uses was found (resolv.conf, systemd-resolved)"

    mapfile -t nics < <(nos_nics)
    pci=$(nic_pci "$dev")
    for i in "${!nics[@]}"; do
        [ "${nics[$i]}" != "$pci" ] || default_eth=eth$i
    done
    if [ -z "$default_eth" ] && [ -n "$pci" ]; then
        die "--network-here: the default route is on $dev ($pci), which nos does not drive"
    fi
    # A container's or another non-PCI default interface is eth0 as it was.
    default_eth=${default_eth:-eth0}
    printf 'default|%s\ndns|%s\n' "$default_eth" "$dns"

    for i in "${!nics[@]}"; do
        pci=${nics[$i]}
        for link in /sys/class/net/*; do
            [ -e "$link" ] || continue
            name=${link##*/}
            [ "$(nic_pci "$name")" = "$pci" ] || continue
            addr=$(ip -4 -o addr show dev "$name" scope global 2>/dev/null | awk '{ print $4; exit }')
            [ -n "$addr" ] || continue
            mode=static
            [ -z "$(ip -4 route show dev "$name" proto dhcp 2>/dev/null)" ] || mode=dhcp
            nicgw=
            if [ "$name" = "$dev" ]; then
                nicgw=$gw
            else
                nicgw=$(ip -4 route show dev "$name" 2>/dev/null | awk '$2 == "via" { print $3; exit }')
            fi
            printf 'nic|eth%s|%s|%s|%s|%s\n' "$i" "$mode" "$addr" "$nicgw" "$name"
            [ "$name" != "$dev" ] || recorded=1
        done
    done
    if [ -z "$recorded" ]; then
        mode=static
        [ -z "$(ip -4 route show dev "$dev" proto dhcp 2>/dev/null)" ] || mode=dhcp
        printf 'nic|%s|%s|%s|%s|%s\n' "$default_eth" "$mode" "$addr" "$gw" "$dev"
    fi
    while read -r target via n; do
        [ -n "$n" ] || continue
        pci=$(nic_pci "$n")
        default_eth=
        for i in "${!nics[@]}"; do
            [ "${nics[$i]}" != "$pci" ] || default_eth=eth$i
        done
        [ -n "$default_eth" ] || continue
        printf 'route|%s|%s|%s\n' "$default_eth" "$target" "$via"
    done < <(ip -4 route show 2>/dev/null | awk '$2 == "via" && $1 != "default" { print $1, $3, $5 }')
}

# The old, one-line summary for the dialog and for a one-interface install.
network_here_summary() {
    local data=$1 kind a b c d e default=eth0 dns= addr= gw=
    while IFS='|' read -r kind a b c d e; do
        case "$kind" in
            default) default=$a ;;
            dns) dns=$a ;;
            nic)
                [ "$a" = "$default" ] || continue
                addr=$c
                gw=$d ;;
        esac
    done <<<"$data"
    [ -z "$addr" ] || printf 'ip=%s ' "$addr"
    [ -z "$gw" ] || printf 'gw=%s ' "$gw"
    printf 'dns=%s\n' "$dns"
}

network_here() {
    local data
    data=$(network_here_data)
    network_here_summary "$data"
}

network_here_is_multi() {
    local data=$1 kind a b c d e default=eth0 nics=0
    while IFS='|' read -r kind a b c d e; do
        case "$kind" in
            default) default=$a ;;
            nic) nics=$((nics + 1)) ;;
            route) return 0 ;;
        esac
    done <<<"$data"
    [ "$default" != eth0 ] || [ "$nics" -gt 1 ]
}

# /etc/net.toml's new per-interface form, or the original one when this
# Linux has one interface and no additional routes.
network_here_toml() {
    local data=$1 kind a b c d e default=eth0 dns= multi=0 routes=()
    if network_here_is_multi "$data"; then
        multi=1
    fi
    while IFS='|' read -r kind a b c d e; do
        case "$kind" in
            default) default=$a ;;
            dns) dns=$a ;;
            nic)
                if [ "$multi" = 0 ]; then
                    case "$b" in
                        static)
                            printf 'ip = "%s"\n' "$c"
                            [ -z "$d" ] || printf 'gw = "%s"\n' "$d" ;;
                        dhcp) printf 'dhcp = true\n' ;;
                    esac
                else
                    case "$b" in
                        static)
                            printf 'ip_%s = "%s"\n' "$a" "$c"
                            [ -z "$d" ] || printf 'gw_%s = "%s"\n' "$a" "$d" ;;
                        dhcp) printf 'dhcp_%s = true\n' "$a" ;;
                    esac
                fi ;;
            route) routes+=("$a|$b|$c") ;;
        esac
    done <<<"$data"
    [ -z "$dns" ] || printf 'dns = "%s"\n' "$dns"
    [ "$multi" = 0 ] || printf 'default = "%s"\n' "$default"
    local r dev net gw seen=() line
    for r in ${routes[@]+"${routes[@]}"}; do
        IFS='|' read -r dev net gw <<<"$r"
        case " ${seen[*]-} " in *" $dev "*) continue ;; esac
        seen+=("$dev")
        line=
        for r in ${routes[@]+"${routes[@]}"}; do
            IFS='|' read -r a b c <<<"$r"
            [ "$a" = "$dev" ] || continue
            line+="${line:+, }\"$b via $c\""
        done
        printf 'route_%s = [%s]\n' "$dev" "$line"
    done
}

# ---- the interfaces' settings: /etc/net.toml -----------------------------
#
# What nos takes is what its kernel takes (net::settings): these checks are
# its rules, so that nothing is written the kernel would refuse -- a refused
# file is a boot on the kernel command line's settings, which on a network
# with no DHCP server is a server nobody can reach.

# The value of the dotted quad $1, or a failure
quad_value() {
    local a b c d x
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
    a=$((10#${BASH_REMATCH[1]})); b=$((10#${BASH_REMATCH[2]}))
    c=$((10#${BASH_REMATCH[3]})); d=$((10#${BASH_REMATCH[4]}))
    for x in "$a" "$b" "$c" "$d"; do
        [ "$x" -le 255 ] || return 1
    done
    echo $(( (a << 24) | (b << 16) | (c << 8) | d ))
}

# Whether a host may have the address of value $1 (RFC 1122 3.2.1.3): not
# "this network", not loopback, not multicast or reserved
may_have() {
    local first=$(( $1 >> 24 ))
    [ "$first" -ne 0 ] && [ "$first" -ne 127 ] && [ "$first" -lt 224 ]
}

# The mask of a prefix of $1 bits, 1 to 32
prefix_mask() {
    echo $(( (0xFFFFFFFF << (32 - $1)) & 0xFFFFFFFF ))
}

# Whether the address of value $1 is the network or the broadcast address of
# its subnet of $2 bits -- which a /31 or a /32 has neither of
network_or_broadcast() {
    local mask host
    [ "$2" -le 30 ] || return 1
    mask=$(prefix_mask "$2")
    host=$(( $1 & ~mask & 0xFFFFFFFF ))
    [ "$host" -eq 0 ] || [ "$host" -eq $(( ~mask & 0xFFFFFFFF )) ]
}

# What is wrong with eth0's address A.B.C.D/N $1, or nothing
ip_wrong() {
    local addr bits value
    if ! [[ "$1" =~ ^([0-9.]+)/([0-9]{1,2})$ ]]; then
        echo "is not an address and its prefix length, A.B.C.D/N"
        return 0
    fi
    addr=${BASH_REMATCH[1]}
    bits=$((10#${BASH_REMATCH[2]}))
    if ! value=$(quad_value "$addr"); then
        echo "is not an address and its prefix length, A.B.C.D/N"
    elif [ "$bits" -lt 1 ] || [ "$bits" -gt 32 ]; then
        echo "has a prefix length that is not 1 to 32"
    elif ! may_have "$value"; then
        echo "is not an address a host may have"
    elif network_or_broadcast "$value" "$bits"; then
        echo "is its subnet's network or broadcast address"
    fi
}

# What is wrong with $1 as a gateway's or a DNS server's address, or nothing
host_wrong() {
    local value
    if ! value=$(quad_value "$1"); then
        echo "is not an address, A.B.C.D"
    elif ! may_have "$value"; then
        echo "is not an address a host may have"
    fi
}

# What is wrong with $1 as the gateway of eth0's address A.B.C.D/N $2 --
# another address of its subnet -- or nothing
gw_wrong() {
    local why bits g a mask
    why=$(host_wrong "$1")
    if [ -n "$why" ]; then
        echo "$why"
        return 0
    fi
    bits=$((10#${2#*/}))
    g=$(quad_value "$1")
    a=$(quad_value "${2%/*}")
    mask=$(prefix_mask "$bits")
    if [ "$g" -eq "$a" ] || [ $(( (g ^ a) & mask )) -ne 0 ]; then
        echo "is not another address of $2's subnet"
    elif network_or_broadcast "$g" "$bits"; then
        echo "is its subnet's network or broadcast address"
    fi
}

# What is wrong with the settings in NET_*, or nothing: what the kernel
# would refuse the file for
net_wrong() {
    local why
    [ "$NET_MODE" != multi ] || return 0
    if [ "$NET_MODE" = static ]; then
        why=$(ip_wrong "$NET_IP")
        [ -z "$why" ] || { echo "the address $NET_IP $why"; return 0; }
        if [ -n "$NET_GW" ]; then
            why=$(gw_wrong "$NET_GW" "$NET_IP")
            [ -z "$why" ] || { echo "the gateway $NET_GW $why"; return 0; }
        fi
    fi
    if [ -n "$NET_DNS" ]; then
        why=$(host_wrong "$NET_DNS")
        [ -z "$why" ] || echo "the DNS server $NET_DNS $why"
    fi
}

# The options' settings checked, and --network-here's taken: before anything
# is written
compose_network() {
    local here data kind value rest words=() w why
    if [ "$NETWORK_HERE" = 1 ]; then
        [ -z "$NET_IP" ] && [ -z "$NET_GW" ] && [ "$NET_MODE" != dhcp ] ||
            die "--network-here is this Linux's addresses and routes: not with --ip, --gw or --dhcp"
        # An assignment of its own, so that its die ends the run
        data=$(network_here_data)
        here=$(network_here_summary "$data")
        while IFS='|' read -r kind value rest; do
            [ "$kind" = default ] || continue
            NET_DEFAULT=$value
        done <<<"$data"
        read -r -a words <<<"$here"
        for w in "${words[@]}"; do
            case "$w" in
                ip=*) NET_IP=${w#ip=} ;;
                gw=*) NET_GW=${w#gw=} ;;
                dns=*) [ -n "$NET_DNS" ] || NET_DNS=${w#dns=} ;;
            esac
        done
        NET_MULTI_TOML=$(network_here_toml "$data")
    fi
    if [ -n "$NET_IP" ]; then
        [ "$NET_MODE" != dhcp ] || die "--ip and --dhcp: nos's address is the one given, or DHCP's"
        NET_MODE=static
    elif [ -n "$NET_GW" ]; then
        die "--gw without --ip: a gateway is the way off --ip's subnet"
    elif [ "$SET_NETWORK" = 1 ]; then
        # --dhcp, or --dns alone: DHCP with that resolver
        NET_MODE=dhcp
    fi
    if [ "$NETWORK_HERE" = 1 ] && network_here_is_multi "$data"; then
        NET_MODE=multi
    elif [ "$NETWORK_HERE" = 1 ] && [[ "$NET_MULTI_TOML" == *"dhcp = true"* ]]; then
        NET_MODE=dhcp
        NET_IP=
        NET_GW=
    fi
    why=$(net_wrong)
    [ -z "$why" ] || die "nos's network: $why"
    if [ "$NET_MODE" = static ] && [ -z "$NET_GW" ]; then
        warn "--ip without --gw: nos reaches its own subnet, $NET_IP, and nothing past it"
    fi
}

nbs_host_default() {
    local name
    name=$(hostname 2>/dev/null | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9-]+/-/g' | cut -c1-63)
    name=${name#-}
    name=${name%-}
    [ -n "$name" ] || name=node
    printf '%s\n' "$name"
}

compose_nbs() {
    if [ -n "$NBS_HOST" ] && [ "$NBS" != 1 ]; then
        die "--nbs-host goes with --nbs"
    fi
    [ "$NBS" = 1 ] || return 0
    [ -n "$NBS_HOST" ] || NBS_HOST=$(nbs_host_default)
    [[ "$NBS_HOST" =~ ^[a-z0-9-]{1,63}$ ]] ||
        die "--nbs-host: $NBS_HOST is not lowercase letters, digits and -, up to 63 characters"
}

# What the settings in NET_* come to, said
net_said() {
    case "$NET_MODE" in
        multi) echo "$NET_IP${NET_GW:+, gateway $NET_GW}${NET_DNS:+, DNS $NET_DNS}, default $NET_DEFAULT, the other interface's settings and routes in $NET_TOML_PATH" ;;
        static) echo "$NET_IP${NET_GW:+, gateway $NET_GW}${NET_DNS:+, DNS $NET_DNS}" ;;
        manual) echo "no address until nos's dhcp command${NET_DNS:+, DNS $NET_DNS}" ;;
        *) echo "DHCP${NET_DNS:+, DNS $NET_DNS}" ;;
    esac
}

# /etc/net.toml's text for the settings in NET_* (net::settings reads it)
net_toml_text() {
    if [ "$NET_MODE" = multi ]; then
        echo "# Interfaces by nos's PCI order. dhcp_ethN, or ip_ethN with an optional"
        echo "# gw_ethN; default is the default route's interface. route_ethN holds"
        echo "# additional networks. Changed here, they are taken at the next boot."
        printf '%s\n' "$NET_MULTI_TOML"
        return 0
    fi
    echo "# eth0's settings, read by nos at every boot: a static address -- ip,"
    echo "# with its gateway, gw -- or DHCP; dns, the DNS server, where one is"
    echo "# given. Changed here, they are taken at the next boot (docs/install.md)."
    case "$NET_MODE" in
        static)
            echo "ip = \"$NET_IP\""
            [ -z "$NET_GW" ] || echo "gw = \"$NET_GW\"" ;;
        manual) echo "dhcp = false" ;;
        *) echo "dhcp = true" ;;
    esac
    [ -z "$NET_DNS" ] || echo "dns = \"$NET_DNS\""
}

# The same settings as kernel parameters: what a kernel from before
# /etc/net.toml reads in its place. DHCP is nos.cfg's own dhcp=auto dns=on
net_words() {
    case "$NET_MODE" in
        multi) echo "" ;;
        static) echo "ip=$NET_IP${NET_GW:+ gw=$NET_GW}${NET_DNS:+ dns=$NET_DNS}" ;;
        manual) echo "dhcp=on${NET_DNS:+ dns=$NET_DNS}" ;;
        *) echo "${NET_DNS:+dns=$NET_DNS}" ;;
    esac
}

# The words of kernel parameters $1 that are eth0's settings, and the rest
network_words_in() {
    local words=() w out=()
    read -r -a words <<<"$1" || true
    for w in ${words[@]+"${words[@]}"}; do
        case "$w" in ip=*|gw=*|dns=*|dhcp=*) out+=("$w") ;; esac
    done
    echo ${out[@]+"${out[@]}"}
}

other_words_in() {
    local words=() w out=()
    read -r -a words <<<"$1" || true
    for w in ${words[@]+"${words[@]}"}; do
        case "$w" in ip=*|gw=*|dns=*|dhcp=*) ;; *) out+=("$w") ;; esac
    done
    echo ${out[@]+"${out[@]}"}
}

# NET_* from the kernel parameters' ip=, gw=, dns= and dhcp= $1 -- a
# grubenv's from before /etc/net.toml -- or a failure, with what stands in
# the way in NET_WHY: a word the file has nothing for, a word the kernel
# would have dropped. The last of each, as the kernel took them. Not to be
# called in a $(...), whose NET_* would be its own
NET_WHY=
net_from_words() {
    local words=() w ip= gw= dns= dhcp=auto
    NET_WHY=
    read -r -a words <<<"$1" || true
    for w in ${words[@]+"${words[@]}"}; do
        case "$w" in
            ip=*) ip=${w#ip=} ;;
            gw=*) gw=${w#gw=} ;;
            dns=on) ;;
            dns=*) dns=${w#dns=} ;;
            dhcp=*) dhcp=${w#dhcp=} ;;
        esac
    done
    case "$dhcp" in
        auto|on) ;;
        off) NET_WHY="dhcp=off, which $NET_TOML_PATH has no word for"; return 1 ;;
        *) NET_WHY="dhcp=$dhcp is not auto, on or off"; return 1 ;;
    esac
    NET_IP=$ip
    NET_GW=$gw
    NET_DNS=$dns
    if [ -n "$ip" ]; then
        NET_MODE=static
    elif [ -n "$gw" ]; then
        NET_WHY="gw=$gw without ip="
        return 1
    elif [ "$dhcp" = on ]; then
        NET_MODE=manual
    else
        NET_MODE=dhcp
    fi
    NET_WHY=$(net_wrong)
    [ -z "$NET_WHY" ]
}

# Whether every kernel on the root at $1 reads /etc/net.toml -- the one
# booted, the one a rollback goes back to, one tried once: the path is in
# the image of a kernel that does
kernels_read_net_toml() {
    local k
    for k in "$1/boot/kernel64.elf" "$1/boot/kernel64.elf.prev" "$1/boot/kernel64.elf.next"; do
        [ -e "$k" ] || continue
        grep -qaF "$NET_TOML_PATH" "$k" || return 1
    done
}

# Every kernel a boot may choose understands the per-interface file too. An
# older rollback would refuse it and have no external address of its own.
kernels_read_multi_net_toml() {
    local k
    for k in "$1/boot/kernel64.elf" "$1/boot/kernel64.elf.prev" "$1/boot/kernel64.elf.next"; do
        [ -e "$k" ] || continue
        grep -qaF "net.toml multi-NIC v2" "$k" || return 1
    done
}

# The default interface is also where a new installation's sshd listens.
# Only the stock command (or one written by an earlier such install) is
# replaced; a custom port or another command is the owner's.
put_ssh_nic() {
    local rc=$1/etc/rc
    [ "$NET_MODE" = multi ] || return 0
    [ -f "$rc" ] || return 0
    sed -E "s/^sshd start( 22 nic=eth[0-9]+)?$/sshd start 22 nic=$NET_DEFAULT/" "$rc" > "$rc.new"
    if ! cmp -s "$rc" "$rc.new"; then
        mv -T "$rc.new" "$rc"
        say "/etc/rc: sshd start 22 nic=$NET_DEFAULT, the default route's interface"
    fi
    rm -f "$rc.new"
}

# The interfaces' settings on the root at $1: /etc/net.toml as the options say; else
# the one there, kept; else -- an install from before the file -- written
# from the kernel parameters it had, $2; else DHCP, which is what nos.cfg's
# own dhcp=auto dns=on had it ask. Then the kernel parameters: while a
# kernel on the root does not read the file, they carry the same settings
# as words for it; once none is left, the words go
put_network() {
    local mnt=$1 before=$2 file=$1/$NET_TOML wrote=0 now rest words new
    mkdir -p "$mnt/etc"
    if [ "$NET_MODE" = multi ] && ! kernels_read_multi_net_toml "$mnt"; then
        die "a multi-interface $NET_TOML_PATH needs every kernel on $PART to support it: update once with the old settings, then again with --network-here"
    fi
    if [ "$SET_NETWORK" = 1 ]; then
        wrote=1
    elif [ -f "$file" ]; then
        say "$NET_TOML_PATH kept as it is: $(net_toml_summary "$file")"
    elif [ -n "$(network_words_in "$before")" ]; then
        if net_from_words "$(network_words_in "$before")"; then
            wrote=1
            say "$NET_TOML_PATH written from this machine's kernel parameters, $(network_words_in "$before")"
        else
            warn "this machine's kernel parameters $(network_words_in "$before") are not written to $NET_TOML_PATH: $NET_WHY -- nos goes by them as it did"
            return 0
        fi
    else
        NET_MODE=dhcp
        wrote=1
    fi
    if [ "$wrote" = 1 ]; then
        net_toml_text > "$file.new"
        sync -f "$mnt"
        mv -T "$file.new" "$file"
        say "$NET_TOML_PATH: $(net_said)"
    fi
    put_ssh_nic "$mnt"

    now=$(editenv "$mnt/grubenv" list | sed -n 's/^nos_cmdline=//p')
    rest=$(other_words_in "$now")
    if kernels_read_net_toml "$mnt"; then
        words=
    elif [ "$wrote" = 1 ]; then
        words=$(net_words)
    else
        # A file kept, which a kernel that does not read it ignores: the
        # words it booted with, as they were
        words=$(network_words_in "$before")
    fi
    new="$rest${rest:+${words:+ }}$words"
    [ "$new" != "$now" ] || return 0
    [ "${#new}" -le "$CMDLINE_MAX" ] ||
        die "the kernel parameters would be ${#new} characters, past the $CMDLINE_MAX left of the kernel's 255: $new"
    editenv "$mnt/grubenv" set "nos_cmdline=$new"
    if [ -n "$words" ]; then
        say "the kernel parameters keep $words: a kernel on $PART from before $NET_TOML_PATH reads them in its place"
    else
        say "the kernel parameters' ip=, gw=, dns= and dhcp= taken out: every kernel on $PART reads $NET_TOML_PATH"
    fi
}

# What /etc/net.toml at $1 says, on a line: its lines, the comments aside
net_toml_summary() {
    sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$1" | awk '{ printf "%s%s", sep, $0; sep = "; " } END { print "" }'
}

compose_cmdline() {
    local parts=() words=() t
    [ -z "$UDPSHELL" ] || parts+=("udpshell=$UDPSHELL")
    [ -z "$NETCONSOLE" ] || parts+=("netconsole=$NETCONSOLE")
    # Split on blanks only: a * in it is not a file name
    read -r -a words <<<"$EXTRA" || true
    for t in ${words[@]+"${words[@]}"}; do
        [[ "$t" =~ ^[A-Za-z0-9_.:,/+=-]+$ ]] ||
            die "--cmdline: '$t' -- a kernel parameter is key=value (docs/kernel-parameters.md)"
        case "$t" in
            ip=*|gw=*|dns=*|dhcp=*)
                die "--cmdline: '$t' -- eth0's settings are $NET_TOML_PATH's: --ip, --gw, --dns, --dhcp or --network-here" ;;
        esac
        parts+=("$t")
    done
    CMDLINE=${parts[*]+"${parts[*]}"}
    [ "${#CMDLINE}" -le "$CMDLINE_MAX" ] ||
        die "the kernel parameters are ${#CMDLINE} characters, past the $CMDLINE_MAX left of the kernel's 255"
}

# A part of the system from the image into place: the new one beside the old
# first, then the old one to .prev and the new one in its stead. A part the
# image does not have goes to .prev all the same, with nothing in its place,
# and a .prev with no part on the partition before it is let go of: .prev is
# the install before this one, no more and no less (rollback)
replace() {
    local from=$1 to=$2
    rm -rf "$to.new"
    if [ -e "$from" ]; then
        cp -r "$from" "$to.new"
        sync -f "$(dirname "$to")"
    fi
    rm -rf "$to.prev"
    if [ -e "$to" ]; then
        mv -T "$to" "$to.prev"
    fi
    if [ -e "$to.new" ]; then
        mv -T "$to.new" "$to"
    fi
}

put_system() {
    local mnt=$1 line p before
    mkdir -p "$mnt/boot/grub" "$mnt/lib" "$mnt/etc/ssh"

    # The system goes together, and what was there goes to .prev together
    # (SYSTEM, rollback)
    for p in $SYSTEM; do
        replace "$IMG/$p" "$mnt/$p"
    done
    rm -rf "$mnt/boot/grub/nos.cfg.new"
    cp "$IMG/boot/grub/nos.cfg" "$mnt/boot/grub/nos.cfg.new"
    mv -T "$mnt/boot/grub/nos.cfg.new" "$mnt/boot/grub/nos.cfg"

    # /etc is this machine's: the image's /etc/rc goes only where there is
    # none, and one that loads a module from elsewhere is said, since that
    # module is of another build now, which the kernel refuses
    if [ ! -e "$mnt/etc/rc" ]; then
        cp "$IMG/etc/rc" "$mnt/etc/rc"
    else
        while IFS= read -r line; do
            case "$line" in
                insmod\ /lib/modules/*) ;;
                insmod\ *) warn "/etc/rc on it runs '$line': that module is not the image's, and a kernel refuses one built against another kernel interface" ;;
            esac
        done < "$mnt/etc/rc"
    fi

    local keys=$mnt/etc/ssh/authorized_keys k blob
    for k in ${KEYS[@]+"${KEYS[@]}"}; do
        read -r _ blob _ <<<"$k"
        if [ -f "$keys" ] && grep -qF " $blob" "$keys"; then
            continue
        fi
        if [ -s "$keys" ] && [ -n "$(tail -c 1 "$keys")" ]; then
            echo >> "$keys"
        fi
        echo "$k" >> "$keys"
        say "sshd lets in: $k"
    done

    put_ucode "$mnt"
    put_seed "$mnt"
    put_nbs "$mnt"
    put_panel "$mnt"

    # The grubenv: what this machine boots nos with, and the one-shot flag
    # GRUB reads and clears (42_nos) -- in place, its one block, which is
    # why it is only ever written by GRUB's own tool
    [ -f "$mnt/grubenv" ] || editenv "$mnt/grubenv" create
    before=$(editenv "$mnt/grubenv" list | sed -n 's/^nos_cmdline=//p')
    if [ "$SET_CMDLINE" = 1 ]; then
        editenv "$mnt/grubenv" set "nos_cmdline=$CMDLINE"
    fi

    # eth0's settings, and the kernel parameters a kernel before them reads
    put_network "$mnt" "$before"
}

# The management panel (--panel, --no-panel): /etc/rc's lines, and root's
# password -- made once, its hash kept, the password itself printed and
# kept nowhere. An update with --panel keeps the password there is.
put_panel() {
    local mnt=$1 rc=$1/etc/rc line password addr
    case "$PANEL" in
        1)
            for line in "${PANEL_RC[@]}"; do
                grep -qxF -- "$line" "$rc" && continue
                if [ -s "$rc" ] && [ -n "$(tail -c 1 "$rc")" ]; then
                    echo >> "$rc"
                fi
                echo "$line" >> "$rc"
                say "/etc/rc: $line"
            done
            if [ -f "$mnt/$PANEL_PASS" ]; then
                say "the panel's password is the one made with it: /$PANEL_PASS has its hash"
                return 0
            fi
            mkdir -p "$mnt/etc/api"
            password=$(panel_password "$mnt/$PANEL_PASS") || die "the panel's password could not be made"
            if [ "$NET_MODE" = static ]; then
                addr=${NET_IP%/*}
            else
                addr=$(this_address)
            fi
            [ -n "$addr" ] || addr="<this machine's address>"
            say "the panel: https://$addr:$PANEL_PORT once nos has made it, minutes after its first boot"
            say "the panel's user is root, its password $password"
            say "that password is printed this once: /$PANEL_PASS on $PART has its hash alone" ;;
        0)
            if grep -qxF "api panel create" "$rc"; then
                grep -vxF "api panel create" "$rc" > "$rc.new" || true
                mv -T "$rc.new" "$rc"
                say "/etc/rc: api panel create taken out -- the panel's VM is left as it is"
            fi ;;
    esac
}

nbs_nic() {
    local mnt=$1 nic=eth0 configured
    if [ "$NET_MODE" = multi ]; then
        nic=$NET_DEFAULT
    elif [ "$SET_NETWORK" = 0 ] && [ -f "$mnt/$NET_TOML" ]; then
        configured=$(sed -n 's/^[[:space:]]*default[[:space:]]*=[[:space:]]*"\([^"]*\)".*$/\1/p' \
            "$mnt/$NET_TOML" | head -n 1)
        [ -z "$configured" ] || nic=$configured
    fi
    [[ "$nic" =~ ^eth[0-9]+$ ]] || die "NBS's interface $nic is not an ethN from $NET_TOML_PATH"
    printf '%s\n' "$nic"
}

# NBS prepared (--nbs), or its boot lines taken out (--no-nbs). The host's
# identity, registry and NBS state are the machine's: no cluster is made or
# joined here, and no storage device is formatted or added.
put_nbs() {
    local mnt=$1 rc=$1/etc/rc line file nic cluster
    case "$NBS" in
        1)
            nic=$(nbs_nic "$mnt")
            file=$mnt/etc/ipc/hosts.toml
            if [ -e "$file" ]; then
                say "/etc/ipc/hosts.toml kept as it is"
            else
                mkdir -p "$mnt/etc/ipc"
                cluster=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
                [ "${#cluster}" = 32 ] || die "could not make ipcnet's cluster id"
                {
                    echo "# ipcnet's identity, made by nos-install --nbs; cluster init/invite/join is done in the panel"
                    printf 'name = "%s"\n' "$NBS_HOST"
                    printf 'cluster = "%s"\n' "$cluster"
                    printf 'nic = "%s"\n' "$nic"
                    echo "peers = []"
                } > "$file.new"
                sync -f "$mnt/etc/ipc"
                mv -T "$file.new" "$file"
                say "/etc/ipc/hosts.toml: $NBS_HOST on $nic, a fresh cluster id, no peers yet"
            fi
            for line in "${NBS_RC[@]}"; do
                grep -qxF -- "$line" "$rc" && continue
                if [ -s "$rc" ] && [ -n "$(tail -c 1 "$rc")" ]; then
                    echo >> "$rc"
                fi
                echo "$line" >> "$rc"
                say "/etc/rc: $line"
            done
            say "NBS prepared, not initialized: in the panel, Cluster init/invite/join, then Block storage init, add host and add device; volumes take three hosts" ;;
        0)
            for line in "${NBS_RC[@]}"; do
                if grep -qxF -- "$line" "$rc"; then
                    grep -vxF -- "$line" "$rc" > "$rc.new" || true
                    mv -T "$rc.new" "$rc"
                    say "/etc/rc: $line taken out -- /etc/ipc and NBS's state are left as they are"
                fi
            done ;;
    esac
}

# This machine's address, as a route out has it: what nos's eth0 is given
# too, where DHCP gives the same machine the same address
this_address() {
    ip -4 -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' || true
}

# root's password for the panel: random, its scrypt hash written to $1 (0600)
# and the password itself on stdout
panel_password() {
    command -v python3 >/dev/null 2>&1 || die "--panel needs python3: the password's hash is scrypt, Python's"
    python3 - "$1" <<'PY'
import base64, hashlib, os, secrets, sys
password = secrets.token_urlsafe(18)
salt = os.urandom(16)
n, r, p = 1 << 15, 8, 1
digest = hashlib.scrypt(password.encode(), salt=salt, n=n, r=r, p=p, maxmem=128 * n * r * 2, dklen=32)
line = "scrypt$%d$%d$%d$%s$%s\n" % (n, r, p, base64.b64encode(salt).decode(), base64.b64encode(digest).decode())
fd = os.open(sys.argv[1] + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, line.encode())
os.fsync(fd)
os.close(fd)
os.replace(sys.argv[1] + ".new", sys.argv[1])
print(password)
PY
}

# This machine's microcode, from its own system, which keeps it current:
# Intel's file for this CPU, /lib/firmware/intel-ucode/<family>-<model>-
# <stepping>, at /boot/ucode, which GRUB loads beside the kernel and the
# kernel loads on every CPU as it boots (docs/boot.md); none, and nos runs
# firmware's. Refreshed by every install and update.
put_ucode() {
    local mnt=$1 dir=${NOS_UCODE_DIR:-/lib/firmware/intel-ucode} name
    name=$(awk -F': *' '
        /^vendor_id/ { vendor = $2 }
        /^cpu family/ { family = $2 }
        /^model[ \t]*:/ { model = $2 }
        /^stepping/ { stepping = $2 }
        /^$/ { exit }
        END { if (vendor == "GenuineIntel") printf "%02x-%02x-%02x", family, model, stepping }
    ' "${NOS_CPUINFO:-/proc/cpuinfo}")
    if [ -n "$name" ] && [ -f "$dir/$name" ]; then
        rm -f "$mnt/boot/ucode.new"
        cp "$dir/$name" "$mnt/boot/ucode.new"
        mv -T "$mnt/boot/ucode.new" "$mnt/boot/ucode"
        say "microcode: $dir/$name, revision $(ucode_revision "$mnt/boot/ucode")"
    elif [ -e "$mnt/boot/ucode" ]; then
        rm -f "$mnt/boot/ucode"
        say "microcode: none for this CPU here; nos runs firmware's"
    fi
}

# The random pool's seed for nos's next boot (docs/random.md): fresh from
# this machine's /dev/urandom at every install and update. nos mixes it in
# as its root is mounted and writes the next over it; on a CPU with no
# random instruction -- an old Xeon -- it is what sshd's keys are made from.
put_seed() {
    local seed=$1/etc/random-seed
    mkdir -p "$1/etc"
    rm -f "$seed.new"
    head -c 64 /dev/urandom > "$seed.new"
    chmod 600 "$seed.new"
    mv -T "$seed.new" "$seed"
    say "random seed: 64 bytes for nos's next boot"
}

# The revision of the first update in a microcode file, as its header has it
ucode_revision() {
    local word
    word=$(od -An -tx4 -j4 -N4 "$1" | tr -d ' \n')
    if [ -n "$word" ]; then
        printf '0x%x' "0x$word"
    else
        printf 'unknown (the file is too short)'
    fi
}

# ---- GRUB --------------------------------------------------------------

snippet_text() {
    cat <<'EOF' | sed "s/@NOS_UUID@/$1/"
#!/bin/sh
# nos: written by nos-install (docs/install.md). Finds the nos partition by
# its UUID, loads what this machine boots nos with and the one-shot flag from
# the grubenv there, and takes the menu entries from the image on it
# (/boot/grub/nos.cfg). nos_next is cleared before anything is loaded, so a
# nos that does not come up is followed by this machine's default. Delete
# this file and run update-grub to take nos out of the menu; the partition is
# left as it is.
cat <<'GRUB'
insmod part_msdos
insmod part_gpt
insmod ext2
set nos_uuid=@NOS_UUID@
set nos_root=
search --no-floppy --fs-uuid --set=nos_root ${nos_uuid}
if [ -n "${nos_root}" ]; then
  set nos_next=
  set nos_cmdline=
  load_env -f (${nos_root})/grubenv nos_next nos_cmdline
  if [ -f (${nos_root})/boot/grub/nos.cfg ]; then
    source (${nos_root})/boot/grub/nos.cfg
  fi
  if [ -n "${nos_next}" ]; then
    set default="${nos_next}"
    set fallback=0
    set nos_next=
    save_env -f (${nos_root})/grubenv nos_next
    set timeout_style=menu
    set timeout=3
  fi
fi
GRUB
EOF
}

grub_cfg() {
    if [ -f /boot/grub/grub.cfg ]; then
        echo /boot/grub/grub.cfg
    elif [ -f /boot/grub2/grub.cfg ]; then
        echo /boot/grub2/grub.cfg
    fi
    return 0
}

# GRUB's configuration made again from /etc/grub.d, and checked: with nos in
# it ("in") or not ("out")
regenerate_grub() {
    local expect=$1 cfg
    if [ -n "${NOS_UPDATE_GRUB+x}" ]; then
        $NOS_UPDATE_GRUB || die "$NOS_UPDATE_GRUB failed"
        return
    fi
    if command -v update-grub >/dev/null 2>&1; then
        say "update-grub"
        update-grub >/dev/null 2>&1 || { update-grub >&2 || true; die "update-grub failed"; }
    elif command -v grub-mkconfig >/dev/null 2>&1 && [ -d /boot/grub ]; then
        say "grub-mkconfig"
        grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || die "grub-mkconfig failed"
    elif command -v grub2-mkconfig >/dev/null 2>&1 && [ -d /boot/grub2 ]; then
        say "grub2-mkconfig"
        grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || die "grub2-mkconfig failed"
    else
        die "no update-grub or grub-mkconfig here: is GRUB this machine's boot loader?"
    fi

    cfg=$(grub_cfg)
    [ -n "$cfg" ] || die "no grub.cfg in /boot/grub or /boot/grub2 after the update"
    if [ "$expect" = out ]; then
        ! grep -q "^set nos_uuid=" "$cfg" || die "$cfg still has nos in it"
        return
    fi
    grep -q "^set nos_uuid=" "$cfg" ||
        die "$cfg has no nos in it after the update -- is $SNIPPET run by grub-mkconfig?"
    # The entries nos.cfg defines are made at boot and are not in grub.cfg:
    # one there by the same id is someone else's, and it would be booted
    if grep -nE "(--id|menuentry_id_option)[= ]+['\"]?nos(-next)?['\"]?([ {]|$)" "$cfg" >&2; then
        warn "another GRUB entry, above, has the id nos or nos-next (/etc/grub.d/40_custom?): GRUB boots the first entry by an id, which is not this image's -- remove it"
    fi
}

# /etc/grub.d/42_nos for the partition with this UUID; GRUB's configuration
# made again when it changed, or when asked to be
install_snippet() {
    local uuid=$1 always=$2 old tmp
    [ -d "$GRUB_D" ] || die "no $GRUB_D: is GRUB this machine's boot loader?"
    old=$(registered_uuid)
    if [ -n "$old" ] && [ "$old" != "$uuid" ]; then
        warn "the GRUB entry named the partition with UUID $old; it names $uuid now"
    fi
    tmp=$(mktemp "$GRUB_D/.42_nos.XXXXXX")
    snippet_text "$uuid" > "$tmp"
    chmod 755 "$tmp"
    if [ -f "$SNIPPET" ] && cmp -s "$tmp" "$SNIPPET"; then
        rm -f "$tmp"
        [ "$always" = 1 ] || return 0
    else
        mv -T "$tmp" "$SNIPPET"
        say "wrote $SNIPPET"
    fi
    regenerate_grub in
}

reboot_now() {
    say "rebooting"
    sync
    if command -v systemctl >/dev/null 2>&1; then
        exec systemctl reboot
    fi
    exec reboot
}

# ---- a disk of nos's own (disk) ----------------------------------------

DISK=
ROOT_SIZE=$ROOT_SIZE_DEFAULT
WIPE=0
DRY_RUN=0
# The new table's partitions' device nodes, by their numbers
PART_DEV=()
MKFS_FAT=
GRUB_INSTALL=
GRUB_LIB=${NOS_GRUB_LIB:-/usr/lib/grub}
GRUB_BIOS=0
GRUB_EFI=0
FIRMWARE=bios

need_fat() {
    if command -v mkfs.vfat >/dev/null 2>&1; then
        MKFS_FAT=mkfs.vfat
    elif command -v mkfs.fat >/dev/null 2>&1; then
        MKFS_FAT=mkfs.fat
    else
        die "no mkfs.vfat: the EFI System partition is FAT (dosfstools)"
    fi
}

need_grub_install() {
    if command -v grub-install >/dev/null 2>&1; then
        GRUB_INSTALL=grub-install
    elif command -v grub2-install >/dev/null 2>&1; then
        GRUB_INSTALL=grub2-install
    else
        die "no grub-install: GRUB's tools are not installed"
    fi
}

# Which GRUBs go onto the disk: both where both are here. The one for the
# firmware this machine runs has to be -- the disk is to boot here -- and
# the other is said when it is missing, before anything is written
grub_targets() {
    FIRMWARE=$(firmware)
    [ ! -f "$GRUB_LIB/i386-pc/modinfo.sh" ] || GRUB_BIOS=1
    [ ! -f "$GRUB_LIB/x86_64-efi/modinfo.sh" ] || GRUB_EFI=1
    if [ "$FIRMWARE" = bios ] && [ "$GRUB_BIOS" = 0 ]; then
        die "this machine boots by BIOS, and there is no GRUB for BIOS here ($GRUB_LIB/i386-pc: grub-pc-bin)"
    fi
    if [ "$FIRMWARE" = uefi ] && [ "$GRUB_EFI" = 0 ]; then
        die "this machine boots by UEFI, and there is no GRUB for UEFI here ($GRUB_LIB/x86_64-efi: grub-efi-amd64-bin)"
    fi
    [ "$GRUB_BIOS" = 1 ] ||
        warn "no GRUB for BIOS here ($GRUB_LIB/i386-pc: grub-pc-bin): the disk will boot under UEFI only"
    [ "$GRUB_EFI" = 1 ] ||
        warn "no GRUB for UEFI here ($GRUB_LIB/x86_64-efi: grub-efi-amd64-bin): the disk will boot under BIOS only"
}

# --root-size in MiB on stdout: a number of MiB, or one with M, G or T after
# it, or "all" -- the whole disk
parse_root_size() {
    local v=$1 n
    if [ "$v" = all ]; then
        echo all
        return
    fi
    [[ "$v" =~ ^([0-9]{1,9})([MmGgTt]?)$ ]] || die "--root-size: $v is not a size (10G, 512M, all)"
    n=$((10#${BASH_REMATCH[1]}))
    case "${BASH_REMATCH[2]}" in
        ''|M|m) echo "$n" ;;
        G|g) echo $((n * 1024)) ;;
        T|t) echo $((n * 1024 * 1024)) ;;
    esac
}

# $1's model and serial, a tab between them ("-" for one not known): lsblk's,
# else udev's, else what sysfs has -- a lsblk built without udev, as
# Alpine's is, knows neither of an ATA disk
disk_model_serial() {
    local dev=$1 name model serial props=
    name=$(basename "$(readlink -f "$dev")")
    model=$(lsblk -dno MODEL "$dev" 2>/dev/null | sed 's/ *$//' || true)
    serial=$(lsblk -dno SERIAL "$dev" 2>/dev/null | sed 's/ *$//' || true)
    if { [ -z "$model" ] || [ -z "$serial" ]; } && command -v udevadm >/dev/null 2>&1; then
        props=$(udevadm info --query=property --name="$dev" 2>/dev/null || true)
        [ -n "$model" ] || model=$(printf '%s\n' "$props" | sed -n 's/^ID_MODEL=//p' | head -n 1 | tr '_' ' ')
        [ -n "$serial" ] || serial=$(printf '%s\n' "$props" | sed -n 's/^ID_SERIAL_SHORT=//p' | head -n 1)
    fi
    [ -n "$model" ] || model=$(cat "/sys/block/$name/device/model" 2>/dev/null | sed 's/ *$//' || true)
    [ -n "$serial" ] || serial=$(cat "/sys/block/$name/serial" "/sys/block/$name/device/serial" 2>/dev/null |
        head -n 1 | sed 's/^ *//; s/ *$//' || true)
    printf '%s\t%s\n' "${model:--}" "${serial:--}"
}

# N MiB as a person reads it: MiB, GiB or TiB, to a tenth
mib_human() {
    local n=$1
    if [ "$n" -lt 1024 ]; then
        echo "$n MiB"
    elif [ "$n" -lt $((1024 * 1024)) ]; then
        echo "$((n / 1024)).$((n * 10 / 1024 % 10)) GiB"
    else
        echo "$((n / 1048576)).$((n * 10 / 1048576 % 10)) TiB"
    fi
}

# What of $1 is in use, said in a line -- nothing when none of it is: held
# by md, LVM or the device mapper, a filesystem of it mounted, swap on it
disk_in_use() {
    local dev=$1 name sys p holders used s
    name=$(basename "$(readlink -f "$dev")")
    sys=/sys/class/block/$name
    for p in "$sys" "$sys/$name"*; do
        [ -d "$p/holders" ] || continue
        holders=$(ls -A "$p/holders" 2>/dev/null | tr '\n' ' ' || true)
        if [ -n "$holders" ]; then
            echo "$(basename "$p") is held by ${holders% } (RAID, LVM, device mapper)"
            return 0
        fi
    done
    used=$(lsblk -nro MOUNTPOINT "$dev" 2>/dev/null | sed '/^$/d' | tr '\n' ' ' || true)
    if [ -n "$used" ]; then
        echo "mounted at ${used% }"
        return 0
    fi
    while read -r s _; do
        case "$(readlink -f "$s" 2>/dev/null || echo "$s")" in
            "/dev/$name"|"/dev/$name"[0-9p]*) echo "swap on $s"; return 0 ;;
        esac
    done < <(tail -n +2 /proc/swaps 2>/dev/null || true)
}

# The whole disk, and nothing of it in use
check_disk() {
    local dev=$1 name sys used
    [ -b "$dev" ] || die "$dev is not a block device"
    name=$(basename "$(readlink -f "$dev")")
    sys=/sys/class/block/$name
    [ -d "$sys" ] || die "$dev: no $sys"
    [ ! -e "$sys/partition" ] ||
        die "$dev is a partition: disk takes a whole disk (install takes a partition)"
    [ "$(cat "$sys/ro" 2>/dev/null || echo 0)" = 0 ] || die "$dev is read-only"
    used=$(disk_in_use "$dev")
    [ -z "$used" ] || die "$dev is in use: $used"
}

# Whether $1 holds anything but zeros in its $2 MiB from sector $3 on
nonzero_at() {
    [ -n "$(dd if="$1" bs=512 skip="$3" count=$(($2 * MIB / 512)) status=none 2>/dev/null |
        tr -d '\000' | head -c 1)" ]
}

# What $1 holds, in a few words -- nothing when it is blank: no partition
# table or filesystem blkid knows of, no partitions, and nothing but zeros
# in its first and last MiB
disk_holds() {
    local dev=$1 what= t n sectors
    t=$(blkid -p -o value -s PTTYPE "$dev" 2>/dev/null || true)
    [ -z "$t" ] || what="a $t partition table"
    t=$(blkid -p -o value -s TYPE "$dev" 2>/dev/null || true)
    [ -z "$t" ] || what="${what:+$what, }$t"
    n=$(lsblk -nro NAME "$dev" 2>/dev/null | tail -n +2 | wc -l)
    if [ "$n" -gt 0 ]; then
        what="${what:+$what, }$n partitions ($(lsblk -nro NAME,FSTYPE,LABEL "$dev" | tail -n +2 |
            sed 's/ *$//' | paste -sd ';' - | sed 's/;/; /g'))"
    fi
    if [ -z "$what" ]; then
        sectors=$(($(blockdev --getsize64 "$dev") / 512))
        if nonzero_at "$dev" 1 0 || nonzero_at "$dev" 1 $((sectors - MIB / 512)); then
            what="data: its first or last MiB is not all zeros"
        fi
    fi
    echo "$what"
}

# The table disk writes, as sfdisk takes one, into DISK_TABLE -- how many
# partitions it has into DISK_PARTS, and the same as a person reads it into
# DISK_PLAN -- for a root of $2 MiB ("all": the rest of the disk) on $1:
# GRUB's core image for BIOS, the EFI System partition, nos's root, and
# after it the rest, where that is worth a partition -- nos-data, with
# nothing on it. A disk with no room for it is refused here, before
# anything is written
DISK_TABLE=
DISK_PARTS=3
DISK_PLAN=
plan_line() {
    DISK_PLAN="$DISK_PLAN$(printf '  %-10s %-11s %s' "$(mib_human "$1")" "$2" "$3")
"
}
plan_disk() {
    local dev=$1 root=$2 ss per total used rest
    ss=$(blockdev --getss "$dev")
    # A 4Kn disk is untried: BIOS's GRUB on it, and nos's drivers
    [ "$ss" = 512 ] ||
        die "$dev has logical sectors of $ss bytes: a disk of nos's own is one of 512 (BIOS's GRUB, and nos's drivers, are not tried on others)"
    per=$((MIB / ss))
    total=$(($(blockdev --getsize64 "$dev") / MIB))
    used=$((1 + BIOS_BOOT_MIB + ESP_MIB))
    if [ "$root" = all ]; then
        rest=$((total - used - 1))
        [ "$rest" -ge "$ROOT_MIN_MIB" ] ||
            die "$dev is $total MiB: no room for a root of $ROOT_MIN_MIB MiB beside GRUB's $used"
    else
        [ "$root" -ge "$ROOT_MIN_MIB" ] || die "--root-size: $root MiB is less than the $ROOT_MIN_MIB MiB nos's root takes"
        rest=$((total - used - root - 1))
        [ "$rest" -ge 0 ] ||
            die "$dev is $total MiB: no room for a root of $root MiB beside GRUB's $used (--root-size)"
    fi
    DISK_TABLE="label: gpt
start=$per, size=$((BIOS_BOOT_MIB * per)), type=$GPT_BIOS_BOOT, name=\"BIOS boot\"
size=$((ESP_MIB * per)), type=$GPT_ESP, name=\"EFI System\""
    DISK_PLAN=
    plan_line "$BIOS_BOOT_MIB" "BIOS boot" "GRUB's core image, for BIOS"
    plan_line "$ESP_MIB" "EFI System" "FAT32: GRUB for UEFI"
    if [ "$root" = all ]; then
        DISK_TABLE="$DISK_TABLE
type=$GPT_LINUX, name=\"$LABEL\""
        plan_line "$rest" "$LABEL" "nos's root, ext4: the image"
    else
        DISK_TABLE="$DISK_TABLE
size=$((root * per)), type=$GPT_LINUX, name=\"$LABEL\""
        plan_line "$root" "$LABEL" "nos's root, ext4: the image"
        if [ "$rest" -ge "$DATA_MIN_MIB" ]; then
            DISK_TABLE="$DISK_TABLE
type=$GPT_LINUX, name=\"$DATA_NAME\""
            DISK_PARTS=4
            plan_line "$rest" "$DATA_NAME" "nothing on it: the VMs' disks, NBS"
        fi
    fi
}

# The table plan_disk made onto $1. sfdisk wipes what the old table and the
# new partitions' places held that blkid knows (filesystems, RAID, LVM, the
# old table's copy at the end)
partition_disk() {
    local dev=$1
    printf '%s\n' "$DISK_TABLE" | sfdisk --quiet --wipe always --wipe-partitions always "$dev" >/dev/null ||
        die "sfdisk could not write the partition table of $dev"
    disk_partitions "$dev" "$DISK_PARTS"
}

# The partitions of $1 the kernel has, into PART_DEV by number -- waited for
# until there are $2, the table read again once if they are slow to come
disk_partitions() {
    local dev=$1 want=$2 name sys p n tries=0
    name=$(basename "$(readlink -f "$dev")")
    sys=/sys/class/block/$name
    while :; do
        PART_DEV=()
        for p in "$sys/$name"*; do
            [ -f "$p/partition" ] || continue
            n=$(cat "$p/partition")
            [ ! -b "/dev/$(basename "$p")" ] || PART_DEV[n]=/dev/$(basename "$p")
        done
        [ "${#PART_DEV[@]}" -lt "$want" ] || break
        tries=$((tries + 1))
        [ "$tries" -le 100 ] ||
            die "the kernel shows ${#PART_DEV[@]} of the $want partitions written on $dev: reboot, and run this again"
        if [ "$tries" = 10 ]; then
            partx -u "$dev" 2>/dev/null || blockdev --rereadpt "$dev" 2>/dev/null || true
        fi
        sleep 0.1
    done
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle 2>/dev/null || true
    fi
}

# $1 blank to whoever looks: its first and last MiB zeros, so that NBS and
# hv take it for a device with nothing on it
blank_partition() {
    local dev=$1 sectors
    sectors=$(($(blockdev --getsize64 "$dev") / 512))
    dd if=/dev/zero of="$dev" bs=1M count=1 conv=fsync status=none ||
        die "cannot write $dev"
    dd if=/dev/zero of="$dev" bs=512 seek=$((sectors - MIB / 512)) count=$((MIB / 512)) conv=fsync status=none ||
        die "cannot write $dev"
}

# GRUB onto $1: for BIOS, its boot code in the disk's first sector and its
# core image in the BIOS boot partition; for UEFI, \EFI\BOOT\BOOTX64.EFI on
# the EFI System partition $3, the path firmware boots a disk by when it has
# no boot entry for it -- none is made, and the firmware's boot order is
# left as it is. Both find the root ($2 mounted) by its UUID, and their
# modules are on it, in /boot/grub
install_grub() {
    local disk=$1 root=$2 esp=$3 log dir help sb=()
    log=$(mktemp /tmp/nos-grub.XXXXXX)
    TEMP_DIRS+=("$log")
    if [ "$GRUB_BIOS" = 1 ]; then
        say "GRUB for BIOS: its boot code in $disk's first sector, its core image in ${PART_DEV[1]}"
        "$GRUB_INSTALL" --target=i386-pc --boot-directory="$root/boot" "$disk" > "$log" 2>&1 ||
            { cat "$log" >&2; die "grub-install for BIOS onto $disk failed"; }
    fi
    if [ "$GRUB_EFI" = 1 ]; then
        dir=$(mktemp -d /tmp/nos-esp.XXXXXX)
        if ! mount -t vfat "$esp" "$dir"; then
            rmdir "$dir"
            die "cannot mount $esp"
        fi
        MOUNT_DIRS+=("$dir")
        # Debian's and Ubuntu's grub-install put shim and their own signed
        # GRUB there unless told not to -- a GRUB that looks for its
        # configuration in /EFI/<their name> on this partition, not on nos's
        # root
        help=$("$GRUB_INSTALL" --help 2>&1 || true)
        if grep -q -- --no-uefi-secure-boot <<< "$help"; then
            sb=(--no-uefi-secure-boot)
        fi
        say "GRUB for UEFI: \\EFI\\BOOT\\BOOTX64.EFI on $esp"
        "$GRUB_INSTALL" --target=x86_64-efi --efi-directory="$dir" --boot-directory="$root/boot" \
            --removable --no-nvram ${sb[@]+"${sb[@]}"} > "$log" 2>&1 ||
            { cat "$log" >&2; die "grub-install for UEFI onto $esp failed"; }
        [ -f "$dir/EFI/BOOT/BOOTX64.EFI" ] || die "grub-install put no \\EFI\\BOOT\\BOOTX64.EFI on $esp"
        sync -f "$dir"
        umount "$dir" || die "cannot unmount $esp from $dir"
        rmdir "$dir"
    fi
}

# The root's /boot/grub/grub.cfg: what 42_nos does in a server's own GRUB,
# with no other system to fall back to
standalone_cfg_text() {
    cat <<'EOF' | sed "s/@NOS_UUID@/$1/"
# nos: this disk's own GRUB configuration, written by nos-install disk
# (docs/install.md). The disk boots nos alone: this finds nos's root by its
# UUID, loads what this machine boots nos with and the one-shot flag from
# the grubenv there, and takes the menu entries from the image on it
# (/boot/grub/nos.cfg), so a new image brings new entries without this file
# changing. nos is the default. nos_next -- nos-next, a kernel tried once --
# is cleared before anything is loaded, and one GRUB cannot boot falls back
# to nos.
insmod part_gpt
insmod ext2
set nos_uuid=@NOS_UUID@
set nos_root=
search --no-floppy --fs-uuid --set=nos_root ${nos_uuid}
set default=nos
set timeout_style=menu
set timeout=3
if [ -n "${nos_root}" ]; then
  set nos_next=
  set nos_cmdline=
  load_env -f (${nos_root})/grubenv nos_next nos_cmdline
  source (${nos_root})/boot/grub/nos.cfg
  if [ -n "${nos_next}" ]; then
    set default="${nos_next}"
    set fallback=nos
    set nos_next=
    save_env -f (${nos_root})/grubenv nos_next
  fi
fi
EOF
}

# The EFI System partition as fsck.fat sees it, where dosfstools has it
fsck_esp() {
    local esp=$1 tool=
    if command -v fsck.vfat >/dev/null 2>&1; then
        tool=fsck.vfat
    elif command -v fsck.fat >/dev/null 2>&1; then
        tool=fsck.fat
    fi
    [ -n "$tool" ] || return 0
    if ! "$tool" -n "$esp" >/dev/null 2>&1; then
        "$tool" -n "$esp" >&2 || true
        die "$tool finds the EFI System partition $esp damaged"
    fi
}

# ---- the firmware's boot order -----------------------------------------

EFIBOOTMGR=${NOS_EFIBOOTMGR:-efibootmgr}
KEEP_BOOT_ORDER=0
BOOT_DEFAULT=0

# How this machine was started: uefi or bios (NOS_FIRMWARE stands in for it
# in a test)
firmware() {
    if [ -n "${NOS_FIRMWARE:-}" ]; then
        echo "$NOS_FIRMWARE"
    elif [ -d /sys/firmware/efi ]; then
        echo uefi
    else
        echo bios
    fi
}

# Whether this Linux runs in a virtual machine: the CPU's hypervisor flag,
# or a board a hypervisor names (NOS_IN_VM, 0 or 1, in a test). Its firmware
# is the virtual machine's then -- and a provider that installs from an ISO
# by running it in QEMU over the server's disks, as Selectel's qemu-iso
# does, leaves the server's own boot order out of an installer's reach
in_vm() {
    if [ -n "${NOS_IN_VM:-}" ]; then
        [ "$NOS_IN_VM" = 1 ]
        return
    fi
    grep -qw hypervisor /proc/cpuinfo 2>/dev/null && return 0
    case "$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null)" in
        *QEMU*|*KVM*|*VMware*|*VirtualBox*|*Bochs*|*Xen*|*"Virtual Machine"*) return 0 ;;
    esac
    return 1
}

vm_note() {
    in_vm || return 0
    warn "this Linux runs in a virtual machine, and what it set is that machine's firmware's. If nos is for the server under it -- a provider that runs the ISO in QEMU over the server's disks, as Selectel's qemu-iso does -- the server's own boot order is set on the server: from its rescue system, nos-install boot --default (docs/install.md, \"From a provider's rescue system\")"
}

# The EFI System partition of disk $1
disk_esp() {
    local p want
    want=$(printf '%s' "$GPT_ESP" | tr 'A-F' 'a-f')
    for p in $(lsblk -lnpo NAME "$1" 2>/dev/null | tail -n +2); do
        if [ "$(blkid -p -o value -s PART_ENTRY_TYPE "$p" 2>/dev/null | tr 'A-F' 'a-f')" = "$want" ]; then
            echo "$p"
            return 0
        fi
    done
    return 1
}

# The number of the firmware's entry that boots \EFI\BOOT\BOOTX64.EFI off the
# partition with GPT GUID $1 -- one the firmware made for that path by itself
# (AMI's "UEFI OS"), or ours -- as efibootmgr -v lists them: the first of
# them that is on; with $2 "any", where none is, the first that is off;
# nothing for none
efi_find() {
    local guid listing
    guid=$(printf '%s' "$1" | tr 'A-F' 'a-f')
    listing=$("$EFIBOOTMGR" -v 2>/dev/null | tr 'A-Z' 'a-z' || true)
    # An entry's first word is Boot#### and a "*" where it is on
    awk -v g="gpt,$guid," -v any="${2:-}" '
        /^boot[0-9a-f][0-9a-f][0-9a-f][0-9a-f]/ && index($0, g) && index($0, "\\efi\\boot\\bootx64.efi") {
            if (substr($1, 9, 1) == "*") {
                on = toupper(substr($1, 5, 4))
                exit
            }
            if (off == "")
                off = toupper(substr($1, 5, 4))
        }
        END {
            if (on != "")
                print on
            else if (any == "any" && off != "")
                print off
        }' <<< "$listing"
}

# The entry for the EFI System partition $2 of disk $1, on -- its number on
# stdout: the firmware's where one of its is on; else the one it has, off,
# turned on; else one of nos's own, made. Off, an entry is one the firmware
# passes over even as BootNext (edk2's boot manager, AMI's with it). And
# efibootmgr 18 -- Ubuntu 24.04's, Debian 12's -- turns on only the last
# entry it lists: any other it says it cannot find (rhboot/efibootmgr#186),
# so whether one was turned on is read back, and nos's own is made where not
efi_entry() {
    local disk=$1 esp=$2 guid num off part
    guid=$(blkid -p -o value -s PART_ENTRY_UUID "$esp" 2>/dev/null || true)
    if [ -z "$guid" ]; then
        warn "$esp has no GPT partition GUID"
        return 1
    fi
    num=$(efi_find "$guid")
    if [ -n "$num" ]; then
        echo "$num"
        return 0
    fi
    off=$(efi_find "$guid" any)
    if [ -n "$off" ]; then
        "$EFIBOOTMGR" -q -b "$off" -a >/dev/null 2>&1 || true
        num=$(efi_find "$guid")
        if [ -n "$num" ]; then
            say "the firmware's boot entry Boot$num for \\EFI\\BOOT\\BOOTX64.EFI on $esp was off: turned on" >&2
            echo "$num"
            return 0
        fi
        say "the firmware's boot entry Boot$off for \\EFI\\BOOT\\BOOTX64.EFI on $esp is off, and efibootmgr cannot turn it on: an entry of nos's own is made beside it" >&2
    fi
    part=$(blkid -p -o value -s PART_ENTRY_NUMBER "$esp" 2>/dev/null || true)
    if ! "$EFIBOOTMGR" -q -C -d "$disk" -p "$part" -L nos -l '\EFI\BOOT\BOOTX64.EFI' >/dev/null 2>&1; then
        warn "efibootmgr could not make a boot entry for $esp"
        return 1
    fi
    num=$(efi_find "$guid")
    if [ -z "$num" ]; then
        warn "efibootmgr made a boot entry for $esp that it then does not list as on"
        return 1
    fi
    say "the firmware's boot entry Boot$num, nos: \\EFI\\BOOT\\BOOTX64.EFI on $esp" >&2
    echo "$num"
}

# BootOrder with Boot$1 put right after the network's entries that lead it
# -- a provider's PXE first still, for its rescue system -- and nothing else
# moved: the system that booted before nos is the one after it
efi_order_first() {
    local num=$1 order net new= e placed=0
    order=$("$EFIBOOTMGR" 2>/dev/null | sed -n 's/^BootOrder: *//p' | head -n 1 | tr 'a-f' 'A-F')
    # A network entry's device path names a MAC, an IP or a URI: PXE, HTTP boot
    net=" $("$EFIBOOTMGR" -v 2>/dev/null |
        awk '/^Boot[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]/ && /MAC\(|IPv4\(|IPv6\(|Uri\(/ { print toupper(substr($1, 5, 4)) }' |
        tr '\n' ' ') "
    for e in $(printf '%s' "$order" | tr ',' ' '); do
        [ "$e" != "$num" ] || continue
        if [ "$placed" = 0 ]; then
            case "$net" in
                *" $e "*) ;;
                *) new="$new,$num"; placed=1 ;;
            esac
        fi
        new="$new,$e"
    done
    [ "$placed" = 1 ] || new="$new,$num"
    new=${new#,}
    if [ "$new" = "$order" ]; then
        say "the firmware's boot order has nos's entry first after the network's already: $order"
        return 0
    fi
    if ! "$EFIBOOTMGR" -q -o "$new" >/dev/null 2>&1; then
        warn "efibootmgr could not set the boot order $new"
        return 1
    fi
    say "the firmware's boot order: $new (was ${order:-none}) -- the network's entries first, then nos's, Boot$num"
}

# The firmware told to boot the disk of nos's own $1, whose EFI System
# partition is $2: first after the network's entries ("default"), or the
# next boot alone ("once"). A BIOS has nothing a running system can tell it
firmware_boot() {
    local disk=$1 esp=$2 how=$3 num
    if [ "$(firmware)" != uefi ]; then
        say "this machine boots by BIOS: it boots $disk when its own boot order puts the disk first -- its setup, or the provider's panel"
        vm_note
        return 0
    fi
    if ! command -v "$EFIBOOTMGR" >/dev/null 2>&1; then
        warn "no efibootmgr here: the firmware's boot order is as it was -- nos-install boot --default sets it, from a Linux that has efibootmgr"
        return 1
    fi
    num=$(efi_entry "$disk" "$esp") || return 1
    case "$how" in
        default) efi_order_first "$num" || return 1 ;;
        once)
            if ! "$EFIBOOTMGR" -q -n "$num" >/dev/null 2>&1; then
                warn "efibootmgr could not set BootNext to Boot$num"
                return 1
            fi
            say "the next boot is nos's, Boot$num, once (BootNext); the one after it goes by the firmware's order again" ;;
    esac
    vm_note
}

# ---- the commands ------------------------------------------------------

FORMAT=0
BOOT_ONCE=0
REBOOT=0
# --panel 1, --no-panel 0, neither: /etc/rc as it is
PANEL=
# --nbs 1, --no-nbs 0, neither: /etc/rc and /etc/ipc as they are
NBS=
NBS_HOST=
# The options given, for the commands that take few of them
SEEN=

parse_options() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -*) SEEN="$SEEN ${1%%=*}" ;;
        esac
        case "$1" in
            --image) [ $# -ge 2 ] || usage; IMAGE=$2; shift ;;
            --image=*) IMAGE=${1#*=} ;;
            --format) FORMAT=1 ;;
            --ssh-key) [ $# -ge 2 ] || usage; add_ssh_key "$2"; shift ;;
            --ssh-key=*) add_ssh_key "${1#*=}" ;;
            --udpshell) UDPSHELL=$UDPSHELL_DEFAULT_PORT; SET_CMDLINE=1 ;;
            --udpshell=*)
                UDPSHELL=${1#*=}
                [[ "$UDPSHELL" =~ ^[0-9]+$ ]] && [ "$UDPSHELL" -ge 1 ] && [ "$UDPSHELL" -le 65535 ] ||
                    die "--udpshell: $UDPSHELL is not a port"
                SET_CMDLINE=1 ;;
            --netconsole|--netconsole=*)
                if [ "$1" = --netconsole ]; then
                    [ $# -ge 2 ] || usage
                    NETCONSOLE=$2
                    shift
                else
                    NETCONSOLE=${1#*=}
                fi
                [[ "$NETCONSOLE" =~ ^[0-9]+(\.[0-9]+){3}:[0-9]+$ ]] ||
                    die "--netconsole: $NETCONSOLE is not IP:PORT"
                SET_CMDLINE=1 ;;
            --cmdline) [ $# -ge 2 ] || usage; EXTRA=$2; SET_CMDLINE=1; shift ;;
            --cmdline=*) EXTRA=${1#*=}; SET_CMDLINE=1 ;;
            --panel) PANEL=1 ;;
            --no-panel) PANEL=0 ;;
            --nbs) NBS=1 ;;
            --no-nbs) NBS=0 ;;
            --nbs-host) [ $# -ge 2 ] || usage; NBS_HOST=$2; shift ;;
            --nbs-host=*) NBS_HOST=${1#*=} ;;
            --boot-once) BOOT_ONCE=1 ;;
            --reboot) BOOT_ONCE=1; REBOOT=1 ;;
            --root-size) [ $# -ge 2 ] || usage; ROOT_SIZE=$2; shift ;;
            --root-size=*) ROOT_SIZE=${1#*=} ;;
            --wipe) WIPE=1 ;;
            --dry-run) DRY_RUN=1 ;;
            --network-here) NETWORK_HERE=1; SET_NETWORK=1 ;;
            --toml) NETWORK_TOML=1 ;;
            --ip) [ $# -ge 2 ] || usage; NET_IP=$2; SET_NETWORK=1; shift ;;
            --ip=*) NET_IP=${1#*=}; SET_NETWORK=1 ;;
            --gw) [ $# -ge 2 ] || usage; NET_GW=$2; SET_NETWORK=1; shift ;;
            --gw=*) NET_GW=${1#*=}; SET_NETWORK=1 ;;
            --dns) [ $# -ge 2 ] || usage; NET_DNS=$2; SET_NETWORK=1; shift ;;
            --dns=*) NET_DNS=${1#*=}; SET_NETWORK=1 ;;
            --dhcp) NET_MODE=dhcp; SET_NETWORK=1 ;;
            --keep-boot-order) KEEP_BOOT_ORDER=1 ;;
            --default) BOOT_DEFAULT=1 ;;
            -h|--help) usage 0 ;;
            -*) die "unknown option $1 (--help)" ;;
            *)
                [ -z "$PART" ] || die "one device, not $PART and $1"
                PART=$1 ;;
        esac
        shift
    done
}

# Refuses an option the command does not take
only_options() {
    local o
    for o in $SEEN; do
        case " $* " in
            *" $o "*) ;;
            *) die "$COMMAND does not take $o" ;;
        esac
    done
}

cmd_install() {
    local mode=$1 fs uuid before cmdline standalone=0
    need blkid findmnt lsblk mount umount mountpoint mkfs.ext4 dumpe2fs e2fsck
    need_editenv
    if [ "$mode" = install ]; then
        [ -n "$PART" ] || die "install onto which partition? (nos-install install /dev/nvme0n1p4)"
    else
        [ "$FORMAT" = 0 ] || die "update keeps what is on the partition; --format is install's"
    fi
    resolve_partition
    compose_cmdline
    compose_network
    compose_nbs
    open_image
    check_partition "$PART"
    check_hardware "$PART"
    # The root of a disk of nos's own is booted by that disk's GRUB: an
    # update leaves this machine's alone, and an install would put a second
    # GRUB's entry on it
    if is_standalone "$PART"; then
        [ "$mode" = update ] ||
            die "$PART is the root of a disk of nos's own (nos-install disk): nos-install update $PART updates it"
        standalone=1
    fi

    fs=$(blkid -p -o value -s TYPE "$PART" 2>/dev/null || true)
    if [ "$FORMAT" = 1 ] || [ -z "$fs" ]; then
        [ "$mode" = install ] || die "$PART has no filesystem: install the image on it"
        [ -z "$(findmnt -rno TARGET --source "$PART" 2>/dev/null || true)" ] ||
            die "$PART is mounted: unmount it to make a new filesystem there"
        say "making an ext4 filesystem on $PART${fs:+, in place of its $fs}"
        mkfs.ext4 -F -q -L "$LABEL" -b 4096 -m 0 -O "$EXT4_FEATURES" \
            -E lazy_itable_init=0,lazy_journal_init=0 "$PART" ||
            die "mkfs.ext4 on $PART failed"
        # What it made, held to what nos writes all the same
        check_fs "$PART" ext4
        # A new filesystem starts from what the options say
        SET_CMDLINE=1
    elif [ "$fs" = ext2 ] || [ "$fs" = ext4 ]; then
        check_fs "$PART" "$fs"
        fsck_partition "$PART" "before anything is written"
    else
        die "$PART has a $fs filesystem on it, which nos does not take -- --format makes a new one in its place (everything on it is lost)"
    fi

    mount_partition "$PART"
    before=$(describe "$MNT/VERSION")
    put_system "$MNT"
    if [ "$BOOT_ONCE" = 1 ] && [ "$standalone" = 0 ]; then
        editenv "$MNT/grubenv" set nos_next=nos
    fi
    cmdline=$(editenv "$MNT/grubenv" list | sed -n 's/^nos_cmdline=//p')
    unmount_partition "$PART"
    fsck_partition "$PART" "after the image was put on it"

    uuid=$(blkid -p -o value -s UUID "$PART")
    [[ "$uuid" =~ ^[0-9a-fA-F-]{36}$ ]] || die "$PART has no UUID GRUB can find it by"
    if [ "$standalone" = 0 ]; then
        install_snippet "$uuid" "$([ "$mode" = install ] && echo 1 || echo 0)"
    fi

    say "$PART: $(describe "$IMG/VERSION"), was $before"
    say "this machine's kernel parameters: ${cmdline:-none}"
    if [ "${#KEYS[@]}" = 0 ] && [ "$mode" = install ]; then
        warn "no --ssh-key: sshd lets nobody in until /etc/ssh/authorized_keys on $PART has a key"
    fi
    if [ "$standalone" = 1 ]; then
        say "its disk's own GRUB boots it: nothing of this machine's GRUB is changed"
        [ "$REBOOT" = 0 ] || reboot_now
    elif [ "$BOOT_ONCE" = 1 ]; then
        say "the next boot is nos, once; the one after it is this machine's default"
        [ "$REBOOT" = 0 ] || reboot_now
    else
        say "nos-install boot --reboot boots it once"
    fi
}

cmd_rollback() {
    local p m
    need blkid findmnt lsblk mount umount mountpoint e2fsck
    resolve_partition
    check_partition "$PART"
    fsck_partition "$PART" "before anything is written"
    mount_partition "$PART"
    m=$MNT
    # Every image has a kernel, modules and a VERSION; one older than hvboot
    # has no hvboot, and then it is its absence that trades places
    for p in boot/kernel64.elf lib/modules VERSION; do
        [ -e "$m/$p.prev" ] || die "nothing to go back to: no /$p.prev on $PART"
    done
    for p in $SYSTEM; do
        rm -rf "$m/$p.back"
        if [ -e "$m/$p" ]; then
            mv -T "$m/$p" "$m/$p.back"
        fi
        if [ -e "$m/$p.prev" ]; then
            mv -T "$m/$p.prev" "$m/$p"
        fi
        if [ -e "$m/$p.back" ]; then
            mv -T "$m/$p.back" "$m/$p.prev"
        fi
    done
    say "$PART: $(describe "$m/VERSION"), and $(describe "$m/VERSION.prev") is the one to go back to"
    unmount_partition "$PART"
    fsck_partition "$PART" "after the rollback"
}

cmd_boot() {
    need blkid findmnt lsblk mount umount mountpoint e2fsck
    need_editenv
    resolve_partition
    check_partition "$PART"
    if is_standalone "$PART"; then
        # Its disk's GRUB boots nos every time: what is left is the
        # firmware's choice of the disk
        local disk esp
        disk=/dev/$(lsblk -no PKNAME "$PART" 2>/dev/null | head -n 1)
        esp=$(disk_esp "$disk") || die "no EFI System partition on $disk"
        if [ "$BOOT_DEFAULT" = 1 ]; then
            firmware_boot "$disk" "$esp" default || die "the firmware's boot order is not set"
        else
            firmware_boot "$disk" "$esp" once || die "the next boot is not set"
        fi
        [ "$REBOOT" = 0 ] || reboot_now
        return 0
    fi
    [ "$BOOT_DEFAULT" = 0 ] ||
        die "--default is a disk of nos's own's: beside this machine's system, nos is its GRUB's default by GRUB_DEFAULT=nos in /etc/default/grub (docs/install.md)"
    [ -f "$SNIPPET" ] || warn "no $SNIPPET: this machine's GRUB does not look for nos"
    mount_partition "$PART"
    [ -f "$MNT/grubenv" ] || die "no grubenv on $PART: install the image on it first"
    editenv "$MNT/grubenv" set nos_next=nos
    say "the next boot is nos, $(describe "$MNT/VERSION"), once"
    unmount_partition "$PART"
    [ "$REBOOT" = 0 ] || reboot_now
}

cmd_status() {
    local uuid next mp params standalone=0
    need blkid findmnt lsblk mount umount mountpoint
    need_editenv
    uuid=$(registered_uuid)
    if [ -n "$uuid" ]; then
        echo "GRUB entry:  $SNIPPET, UUID $uuid"
    else
        echo "GRUB entry:  none"
    fi
    resolve_partition
    mp=$(findmnt -rno TARGET --source "$PART" 2>/dev/null | head -n 1 || true)
    echo "partition:   $PART${mp:+, mounted at $mp}"
    if is_standalone "$PART"; then
        standalone=1
        echo "booted by:   its disk's own GRUB (nos-install disk)"
    fi
    mount_partition "$PART" ro
    echo "installed:   $(describe "$MNT/VERSION")"
    echo "previous:    $(describe "$MNT/VERSION.prev")"
    if [ -f "$MNT/$NET_TOML" ]; then
        echo "network:     $NET_TOML_PATH: $(net_toml_summary "$MNT/$NET_TOML")"
    else
        echo "network:     no $NET_TOML_PATH: the kernel parameters' ip=, gw=, dns= and dhcp= (nos-install update writes it)"
    fi
    if [ -f "$MNT/grubenv" ]; then
        params=$(editenv "$MNT/grubenv" list | sed -n 's/^nos_cmdline=//p')
        echo "parameters:  ${params:-none}"
        next=$(editenv "$MNT/grubenv" list | sed -n 's/^nos_next=//p')
        if [ -n "$next" ]; then
            echo "next boot:   $next, once"
        elif [ "$standalone" = 1 ]; then
            echo "next boot:   nos, its disk's default"
        else
            echo "next boot:   this machine's default"
        fi
    else
        echo "grubenv:     none"
    fi
    echo "ssh keys:    $(grep -c '^ssh-' "$MNT/etc/ssh/authorized_keys" 2>/dev/null || true)"
    if [ -s "$MNT/etc/random-seed" ]; then
        echo "random seed: kept"
    else
        echo "random seed: none"
    fi
    if [ -f "$MNT/boot/ucode" ]; then
        echo "microcode:   revision $(ucode_revision "$MNT/boot/ucode") at /boot/ucode"
    else
        echo "microcode:   none; nos runs firmware's"
    fi
    unmount_partition "$PART"
}

cmd_uninstall() {
    [ -z "$PART" ] || die "uninstall takes no partition: it takes nos out of GRUB's menu"
    [ -f "$SNIPPET" ] || die "no $SNIPPET: nos is not in GRUB's menu"
    rm -f "$SNIPPET"
    say "removed $SNIPPET"
    regenerate_grub out
    say "nos is out of GRUB's menu; the partition is as it was"
}

# The disks here, a line each and tab-separated, for an installer to offer
# (nos-setup): the device, its size in bytes, its model and serial, "ok" or
# what keeps nos from reading it, what of it is in use, and what it holds --
# "-" for a field with nothing in it, as a tab is IFS whitespace, and two of
# them run together would be read as one
cmd_disks() {
    local name kind dev size model serial problem used holds
    need lsblk blkid blockdev dd
    while read -r name kind; do
        case "$kind" in
            disk) ;;
            loop) [ "${NOS_ALLOW_ANY_DISK:-0}" = 1 ] || continue ;;
            *) continue ;;
        esac
        dev=/dev/$name
        size=$(blockdev --getsize64 "$dev" 2>/dev/null || echo 0)
        [ "$size" -gt 0 ] || continue
        IFS=$'\t' read -r model serial < <(disk_model_serial "$dev")
        problem=$(disk_controller_problem "$dev")
        used=$(disk_in_use "$dev")
        holds=$(disk_holds "$dev")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$dev" "$size" "$model" "$serial" "${problem:-ok}" \
            "${used:--}" "${holds:--}"
    done < <(lsblk -dnro NAME,TYPE 2>/dev/null)
}

# A whole disk made nos's: a GPT of nos's own on it, the image poured onto
# its root, GRUB onto it for BIOS and UEFI. Everything is checked -- the
# image, the disk, what is on it, what GRUB there is -- before anything is
# written; --dry-run stops there, and says what it would write
cmd_disk() {
    local root what esp data uuid cmdline ids
    need blkid findmnt lsblk mount umount mountpoint mkfs.ext4 dumpe2fs e2fsck debugfs \
        sfdisk wipefs blockdev partx dd
    need_editenv
    need_fat
    need_grub_install
    [ -n "$PART" ] || die "onto which disk? (nos-install disk /dev/nvme0n1)"
    DISK=$PART
    PART=
    root=$(parse_root_size "$ROOT_SIZE")
    compose_cmdline
    compose_network
    compose_nbs
    open_image
    check_disk "$DISK"
    check_hardware "$DISK" disk
    grub_targets
    plan_disk "$DISK" "$root"
    what=$(disk_holds "$DISK")
    if [ -n "$what" ]; then
        [ "$WIPE" = 1 ] || die "$DISK holds $what -- --wipe erases it, and everything on it is lost"
        say "erasing $DISK: it held $what"
    fi
    ids=$(disk_model_serial "$DISK" | tr '\t' ' ' | sed 's/^- //; s/ -$//; s/^-$//')
    if [ "$DRY_RUN" = 1 ]; then
        say "$DISK${ids:+ ($ids)}, $(lsblk -dno SIZE "$DISK" | tr -d ' '): would be given a GPT of nos's own --"
        printf '%s' "$DISK_PLAN" | sed 's/^/nos-install: /'
        say "nos's network, $NET_TOML_PATH: $( [ "$SET_NETWORK" = 1 ] && net_said || echo DHCP )"
        [ "$NBS" != 1 ] || say "NBS prepared as $NBS_HOST, with no cluster made and no device added"
        say "$(describe "$IMG/VERSION") on its root, and GRUB for$([ "$GRUB_BIOS" = 0 ] || echo " BIOS")$([ "$GRUB_BIOS" = 0 ] || [ "$GRUB_EFI" = 0 ] || echo " and")$([ "$GRUB_EFI" = 0 ] || echo " UEFI")"
        if [ "$FIRMWARE" = uefi ] && [ "$KEEP_BOOT_ORDER" = 0 ]; then
            say "and the firmware's boot entry for it put first after the network's"
        fi
        return 0
    fi
    say "$DISK${ids:+ ($ids)}, $(lsblk -dno SIZE "$DISK" | tr -d ' '): a GPT of nos's own"

    partition_disk "$DISK"
    esp=${PART_DEV[2]}
    PART=${PART_DEV[3]}
    data=${PART_DEV[4]:-}
    [ -z "$data" ] || blank_partition "$data"
    say "making the EFI System partition $esp, FAT32"
    "$MKFS_FAT" -F 32 -n "$ESP_LABEL" "$esp" >/dev/null || die "$MKFS_FAT on $esp failed"
    say "making an ext4 filesystem on $PART, nos's root"
    mkfs.ext4 -F -q -L "$LABEL" -b 4096 -m 0 -O "$EXT4_FEATURES" \
        -E lazy_itable_init=0,lazy_journal_init=0 "$PART" ||
        die "mkfs.ext4 on $PART failed"
    check_fs "$PART" ext4
    # A new filesystem starts from what the options say
    SET_CMDLINE=1

    mount_partition "$PART"
    put_system "$MNT"
    install_grub "$DISK" "$MNT" "$esp"
    uuid=$(blkid -p -o value -s UUID "$PART")
    [[ "$uuid" =~ ^[0-9a-fA-F-]{36}$ ]] || die "$PART has no UUID GRUB can find it by"
    standalone_cfg_text "$uuid" > "$MNT/boot/grub/grub.cfg.new"
    mv -T "$MNT/boot/grub/grub.cfg.new" "$MNT/boot/grub/grub.cfg"
    cmdline=$(editenv "$MNT/grubenv" list | sed -n 's/^nos_cmdline=//p')
    unmount_partition "$PART"
    fsck_partition "$PART" "after the image was put on it"
    fsck_esp "$esp"
    is_standalone "$PART" || die "$PART does not read back as the root of a disk of nos's own"

    say "$DISK is nos's:"
    lsblk -o NAME,SIZE,PARTLABEL,FSTYPE,LABEL "$DISK" | sed 's/^/nos-install:   /'
    say "root: $PART, $(describe "$IMG/VERSION"), found by its UUID $uuid"
    if [ -n "$data" ]; then
        say "$DATA_NAME: $data, with nothing on it -- a VM's disk (part:$(blkid -p -o value -s PART_ENTRY_UUID "$data" 2>/dev/null || true)), or NBS's (nbs devices add)"
    fi
    if [ "$GRUB_BIOS" = 1 ] && [ "$GRUB_EFI" = 1 ]; then
        say "boots by BIOS and by UEFI; this machine is booted by $FIRMWARE"
    elif [ "$GRUB_BIOS" = 1 ]; then
        say "boots by BIOS only"
    else
        say "boots by UEFI only"
    fi
    say "this machine's kernel parameters: ${cmdline:-none}"
    if [ "${#KEYS[@]}" = 0 ]; then
        warn "no --ssh-key: sshd lets nobody in until /etc/ssh/authorized_keys on $PART has a key"
    fi
    if [ "$KEEP_BOOT_ORDER" = 1 ]; then
        say "the firmware's boot order is left as it is (--keep-boot-order): it boots $DISK when that order puts the disk first"
    elif ! firmware_boot "$DISK" "$esp" default; then
        warn "the firmware's boot order is not set: nos-install boot --default sets it, or the firmware's setup"
    fi
    [ "$REBOOT" = 0 ] || reboot_now
}

[ $# -ge 1 ] || usage
COMMAND=$1
shift
case "$COMMAND" in
    -h|--help|help) usage 0 ;;
esac
[ "$(id -u)" = 0 ] || die "run as root"
parse_options "$@"
case "$COMMAND" in
    install|update)
        only_options --image --format --ssh-key --udpshell --netconsole --cmdline --network-here --ip --gw \
            --dns --dhcp --panel --no-panel --nbs --nbs-host --no-nbs --boot-once --reboot
        cmd_install "$COMMAND" ;;
    disk)
        only_options --image --ssh-key --udpshell --netconsole --cmdline --network-here --ip --gw --dns \
            --dhcp --panel --no-panel --nbs --nbs-host --no-nbs --root-size --wipe --dry-run --keep-boot-order --reboot
        cmd_disk ;;
    disks)
        only_options
        [ -z "$PART" ] || die "disks takes no device: it lists them"
        cmd_disks ;;
    network)
        only_options --toml
        [ -z "$PART" ] || die "network takes no device: it says this Linux's"
        if [ "$NETWORK_TOML" = 1 ]; then
            network_here_toml "$(network_here_data)"
        else
            network_here
        fi ;;
    boot) only_options --reboot --boot-once --default; cmd_boot ;;
    rollback|status|uninstall) only_options; "cmd_$COMMAND" ;;
    *) die "no command $COMMAND (--help)" ;;
esac
