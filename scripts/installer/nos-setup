#!/bin/bash
# nos-setup: the nos installer's dialog (scripts/installer, docs/install.md,
# "From an ISO", "From a provider's rescue system"). It asks which disk, how
# big nos's root, what network, which keys and whether to install the panel
# and prepare NBS, shows what will be written and has the disk's name typed to go on -- then
# hands it all to the system image's nos-install disk, which checks everything
# again and writes.
#
# It runs in one of two places. On the installer ISO -- /etc/nos-installer
# is the ISO's -- in its own Linux, on its console: it mounts the image the
# ISO carries, and sets up the installer's network to try the one given.
# With answers it asks nothing there: /etc/nos-installer/answers, which
# build.sh --answers bakes in (answers.example), and nos.KEY=VALUE words on
# the kernel's command line, which win; what it does goes to the screen and
# to the kernel log -- a netconsole= given to the installer's kernel carries
# it off a machine nobody watches.
#
# Or on a Linux the server runs already -- a provider's rescue system --
# from the system image mounted (install.sh does that): the image is the
# directory this script is in, and the network is the one the session came
# in by, which nothing here touches -- offered to nos as it is, since a
# rescue system is up on the server's own address.
set -uo pipefail
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

IMAGE_DIR=/usr/share/nos
IMAGE=$IMAGE_DIR/nos-x86_64.squashfs
ANSWERS=/etc/nos-installer/answers
MNT=/run/nos-image
if [ -d /etc/nos-installer ]; then
    ON_ISO=1
else
    ON_ISO=0
    MNT=$(dirname "$(readlink -f "$0")")
fi
LOG=/run/nos-setup.log
KEYS_FILE=/run/nos-keys
# An unattended install runs once a boot: init runs this again when it ends
DONE=/run/nos-setup.done
TITLE="nos installer"
ROOT_SIZE_DEFAULT=10G
# How long a link is given to come up, in seconds
CARRIER_WAIT=15

# What the kernel log is given: at the level every console shows -- the
# serial port, netconsole -- while nothing draws a dialog on the screen,
# and below it while one does
KMSG_LEVEL=6

kmsg() {
    [ "$ON_ISO" = 1 ] || return 0
    echo "<$KMSG_LEVEL>$*" > /dev/kmsg 2>/dev/null || true
}

say() {
    echo "nos-setup: $*"
    echo "nos-setup: $*" >> "$LOG"
    kmsg "nos-setup: $*"
}

# ---- the answers --------------------------------------------------------

declare -A ANS=()
KEYS=()
KEY_URLS=()

add_answer() {
    local k=$1 v=$2
    case "$k" in
        key) KEYS+=("$v") ;;
        key_url) KEY_URLS+=("$v") ;;
        disk|wipe|root_size|ip|gw|dns|netconsole|cmdline|panel|nbs|nbs_host|after) ANS[$k]=$v ;;
        *) say "answers: there is no answer called $k -- left out" ;;
    esac
}

read_answers() {
    local line word
    if [ -f "$ANSWERS" ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=${line%$'\r'}
            case "$line" in
                ''|'#'*) continue ;;
                *=*) add_answer "${line%%=*}" "${line#*=}" ;;
                *) say "answers: '$line' is not key=value -- left out" ;;
            esac
        done < "$ANSWERS"
    fi
    for word in $(cat /proc/cmdline); do
        case "$word" in
            nos.*=*)
                word=${word#nos.}
                add_answer "${word%%=*}" "${word#*=}" ;;
        esac
    done
}

# ---- the image ----------------------------------------------------------

open_image() {
    mkdir -p "$MNT"
    mountpoint -q "$MNT" && return 0
    if ! (cd "$IMAGE_DIR" && sha256sum -c SHA256SUMS >/dev/null 2>&1); then
        say "the system image does not match its SHA256SUMS: the installer is damaged -- download it again"
        return 1
    fi
    if ! mount -t squashfs -o loop,ro "$IMAGE" "$MNT"; then
        say "cannot mount the system image $IMAGE"
        return 1
    fi
}

image_version() {
    echo "nos $(sed -n 's/^version=//p' "$MNT/VERSION") ($(sed -n 's/^revision=//p' "$MNT/VERSION"))"
}

nos_install() {
    "$MNT/nos-install" "$@"
}

# ---- the network --------------------------------------------------------

# The machine's network cards with a link, by name
carrier_links() {
    local link
    for link in /sys/class/net/*; do
        [ -e "$link/device" ] || continue
        [ "$(cat "$link/carrier" 2>/dev/null)" = 1 ] && echo "${link##*/}"
    done
    return 0
}

wait_carrier() {
    local i
    for (( i = 0; i < CARRIER_WAIT; i++ )); do
        [ -z "$(carrier_links)" ] || return 0
        sleep 1
    done
    return 1
}

net_dhcp() {
    local link addr
    for link in $(carrier_links); do
        if udhcpc -i "$link" -n -q -t 4 -T 2 >/dev/null 2>&1; then
            addr=$(ip -4 -o addr show dev "$link" | awk '{ print $4 }' | head -n 1)
            say "network: $link, $addr by DHCP"
            return 0
        fi
    done
    say "network: no DHCP server answered on $(carrier_links | tr '\n' ' ')"
    return 1
}

# The address nos is to take, on the installer's first link with a carrier:
# what lets it fetch keys, and shows the address works
net_static() {
    local ip=$1 gw=$2 dns=$3 link
    link=$(carrier_links | head -n 1)
    if [ -z "$link" ]; then
        say "network: no card has a link"
        return 1
    fi
    ip addr flush dev "$link"
    ip addr add "$ip" dev "$link" || return 1
    ip route replace default via "$gw" dev "$link" || return 1
    echo "nameserver $dns" > /etc/resolv.conf
    say "network: $link, $ip, gateway $gw, DNS $dns"
}

# The installer's own kernel log over UDP to $1 (IP:PORT), as nos's will go
# there: what shows an install on a machine nobody watches. Linux's
# netconsole takes the next hop's MAC, found by a ping and the neighbours
installer_netconsole() {
    local to=$1 ip port link src via mac
    ip=${to%:*}
    port=${to##*:}
    link=$(ip -4 route get "$ip" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n 1)
    src=$(ip -4 route get "$ip" 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1)
    via=$(ip -4 route get "$ip" 2>/dev/null | sed -n 's/.* via \([0-9.]*\).*/\1/p' | head -n 1)
    [ -n "$link" ] && [ -n "$src" ] || return 1
    ping -c 1 -W 2 "${via:-$ip}" >/dev/null 2>&1 || true
    mac=$(ip neigh show "${via:-$ip}" dev "$link" 2>/dev/null | awk '{ for (i = 1; i < NF; i++) if ($i == "lladdr") print $(i + 1) }' | head -n 1)
    [ -n "$mac" ] || return 1
    modprobe netconsole "netconsole=@$src/$link,$port@$ip/$mac" 2>/dev/null || return 1
    say "the installer's kernel log goes to $to too"
}

valid_cidr() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]
}

valid_ip() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

# Whether this installer runs in a virtual machine: the CPU's hypervisor
# flag, or a board a hypervisor names. A provider that installs from an ISO
# by running it in QEMU over the server's disks -- Selectel's qemu-iso --
# gives it QEMU's network and firmware, not the server's
in_vm() {
    grep -qw hypervisor /proc/cpuinfo 2>/dev/null && return 0
    case "$(cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>/dev/null)" in
        *QEMU*|*KVM*|*VMware*|*VirtualBox*|*Bochs*|*Xen*|*"Virtual Machine"*) return 0 ;;
    esac
    return 1
}

# The first address of the network A.B.C.D/N is in -- where most networks'
# gateways are (.1 of a /24) -- or nothing for a /31 or /32
first_host() {
    local ip=${1%/*} n=${1#*/} a b c d x mask first
    [ "$n" -le 30 ] || return 0
    IFS=. read -r a b c d <<<"$ip"
    x=$(( (a << 24) | (b << 16) | (c << 8) | d ))
    mask=$(( (0xFFFFFFFF << (32 - n)) & 0xFFFFFFFF ))
    first=$(( (x & mask) + 1 ))
    echo "$(( (first >> 24) & 255 )).$(( (first >> 16) & 255 )).$(( (first >> 8) & 255 )).$(( first & 255 ))"
}

# A netmask's prefix length: 255.255.255.0 is 24
mask_bits() {
    local a b c d x n=0
    IFS=. read -r a b c d <<<"$1"
    x=$(( (a << 24) | (b << 16) | (c << 8) | d ))
    while [ $(( x & 0x80000000 )) != 0 ]; do
        n=$((n + 1))
        x=$(( (x << 1) & 0xFFFFFFFF ))
    done
    echo "$n"
}

# The network a Linux root at $1 is set up with, as its own tools keep it --
# netplan, ifupdown, NetworkManager, systemd-networkd, ifcfg: "A.B.C.D/N
# gateway dns kind:file" of its first static IPv4 address ("-" for a gateway
# or a DNS server not given), or nothing
root_network() {
    local root=$1 got= addr gw dns mask f
    # netplan: an address with its prefix; gateway4:, or the via: of the
    # route to default -- of another route only where there is none; a
    # nameservers: block's addresses. A route is a list item: its to: and
    # via: are taken together when the next item, or the end, closes it
    for f in "$root"/etc/netplan/*.yaml; do
        [ -f "$f" ] || continue
        got=$(tr -d "\"'" < "$f" | awk '
            function lead(s) { match(s, /^ */); return RLENGTH }
            function close_route() {
                if (via != "") {
                    if ((to == "default" || to == "0.0.0.0/0") && dgw == "") dgw = via
                    else if (ogw == "") ogw = via
                }
                to = ""; via = ""
            }
            {
                line = $0; gsub(/[][,]/, " ", line)
                ind = lead($0)
                if (ns && ind <= nsind) ns = 0
                if (line ~ /nameservers:/) { ns = 1; nsind = ind; next }
                if (line ~ /^ *- /) close_route()
                n = split(line, w, /[ \t]+/)
                for (i = 1; i <= n; i++) {
                    if (prev == "to:") {
                        to = w[i]
                    } else if (w[i] ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\/[0-9]+$/) {
                        if (addr == "" && !ns && w[i] !~ /^0\./) addr = w[i]
                    } else if (w[i] ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
                        if (ns) { if (dns == "") dns = w[i] }
                        else if (prev == "gateway4:" && dgw == "") dgw = w[i]
                        else if (prev == "via:") via = w[i]
                    }
                    prev = w[i]
                }
            }
            END {
                close_route()
                gw = (dgw != "" ? dgw : ogw)
                if (addr != "") print addr, (gw == "" ? "-" : gw), (dns == "" ? "-" : dns)
            }')
        [ -z "$got" ] || { echo "$got netplan:${f#"$root"}"; return 0; }
    done
    # ifupdown: address (with a prefix, or a netmask after it), gateway,
    # dns-nameservers
    for f in "$root"/etc/network/interfaces "$root"/etc/network/interfaces.d/*; do
        [ -f "$f" ] || continue
        read -r addr mask gw dns < <(awk '
            $1 == "address" && $2 ~ /^[0-9.]+(\/[0-9]+)?$/ && a == "" { a = $2 }
            $1 == "netmask" && m == "" { m = $2 }
            $1 == "gateway" && $2 ~ /^[0-9.]+$/ && g == "" { g = $2 }
            $1 == "dns-nameservers" && d == "" { d = $2 }
            END { if (a != "") print a, (m == "" ? "-" : m), (g == "" ? "-" : g), (d == "" ? "-" : d) }' "$f")
        [ -n "$addr" ] || continue
        if [[ "$addr" != */* ]] && [ "$mask" != - ]; then
            addr=$addr/$(mask_bits "$mask")
        fi
        echo "$addr $gw $dns ifupdown:${f#"$root"}"
        return 0
    done
    # NetworkManager: [ipv4]'s address1= (with its gateway after a comma),
    # gateway=, dns=
    for f in "$root"/etc/NetworkManager/system-connections/*; do
        [ -f "$f" ] || continue
        got=$(awk '
            /^\[/ { sec = $0 }
            sec == "[ipv4]" && /^address[0-9]*=/ && a == "" {
                split(substr($0, index($0, "=") + 1), x, ","); a = x[1]; if (x[2] != "") g = x[2]
            }
            sec == "[ipv4]" && /^gateway=/ && g == "" { g = substr($0, 9) }
            sec == "[ipv4]" && /^dns=/ && d == "" { split(substr($0, 5), y, ";"); d = y[1] }
            END { if (a ~ /^[0-9.]+\/[0-9]+$/) print a, (g == "" ? "-" : g), (d == "" ? "-" : d) }' "$f")
        [ -z "$got" ] || { echo "$got NetworkManager:${f#"$root"}"; return 0; }
    done
    # systemd-networkd: Address=, Gateway=, DNS=
    for f in "$root"/etc/systemd/network/*.network; do
        [ -f "$f" ] || continue
        got=$(awk -F= '
            $1 == "Address" && $2 ~ /^[0-9.]+\/[0-9]+$/ && a == "" { a = $2 }
            $1 == "Gateway" && $2 ~ /^[0-9.]+$/ && g == "" { g = $2 }
            $1 == "DNS" && d == "" { split($2, y, " "); d = y[1] }
            END { if (a != "") print a, (g == "" ? "-" : g), (d == "" ? "-" : d) }' "$f")
        [ -z "$got" ] || { echo "$got systemd-networkd:${f#"$root"}"; return 0; }
    done
    # ifcfg (RHEL): IPADDR=, PREFIX= or NETMASK=, GATEWAY=, DNS1=
    for f in "$root"/etc/sysconfig/network-scripts/ifcfg-*; do
        [ -f "$f" ] || continue
        read -r addr mask gw dns < <(tr -d "\"'" < "$f" | awk -F= '
            $1 == "IPADDR" { a = $2 } $1 == "PREFIX" { p = $2 } $1 == "NETMASK" { m = $2 }
            $1 == "GATEWAY" { g = $2 } $1 == "DNS1" { d = $2 }
            END { if (a != "") print a "/" (p != "" ? p : "?"), (m == "" ? "-" : m), (g == "" ? "-" : g), (d == "" ? "-" : d) }')
        [ -n "$addr" ] || continue
        if [[ "$addr" == */\? ]]; then
            [ "$mask" != - ] || continue
            addr=${addr%/*}/$(mask_bits "$mask")
        fi
        echo "$addr $gw $dns ifcfg:${f#"$root"}"
        return 0
    done
    return 1
}

# The network a Linux already on this machine's disks has -- the system the
# server came with, which knows its address on a network with no DHCP:
# "A.B.C.D/N gateway dns device kind file", "-" for what it did not say --
# each root mounted read-only, its journal not replayed, and let go of
found_network() {
    local dev fs opts got peek=/run/nos-peek
    mkdir -p "$peek"
    while read -r dev; do
        # Its type as blkid reads it off the device: lsblk's is udev's, and
        # a rescue system may run no udev
        fs=$(blkid -p -o value -s TYPE "$dev" 2>/dev/null || true)
        case "$fs" in
            ext2) opts=ro ;;
            ext3|ext4) opts=ro,noload ;;
            xfs) opts=ro,norecovery ;;
            btrfs) opts=ro,rescue=nologreplay ;;
            *) continue ;;
        esac
        mount -t "$fs" -o "$opts" "$dev" "$peek" 2>/dev/null || continue
        got=$(root_network "$peek" || true)
        umount "$peek" 2>/dev/null || true
        if [ -n "$got" ]; then
            set -- $got
            if valid_cidr "$1"; then
                echo "$1 $2 $3 $dev ${4%%:*} ${4#*:}"
                return 0
            fi
        fi
    done < <(lsblk -lnpo NAME 2>/dev/null)
    return 1
}

# Of the DNS servers $@, the first that answers a query from here
dns_answering() {
    local d
    for d in "$@"; do
        valid_ip "$d" || continue
        if timeout 4 nslookup github.com "$d" >/dev/null 2>&1; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# ---- the keys -----------------------------------------------------------

FETCHED=/run/nos-fetched

# A URL's keys into FETCHED: 1 when it cannot be had at all
fetch_url() {
    rm -f "$FETCHED"
    curl -fsSL --max-time 30 -o "$FETCHED" "$1" 2>/dev/null
}

# Of what came: the ssh-ed25519 lines, the only kind nos's sshd takes
fetched_ed25519() {
    tr -d '\r' < "$FETCHED" | grep -E '^ssh-ed25519 [A-Za-z0-9+/]+=*( .*)?$' || true
}

# Why a URL gave no ssh-ed25519 key, in a few words: keys of other kinds, or
# none at all
fetch_why() {
    local others
    others=$(tr -d '\r' < "$FETCHED" | grep -E '^(ssh-|ecdsa-|sk-)' | grep -v -c '^ssh-ed25519 ' || true)
    if [ "${others:-0}" -gt 0 ]; then
        echo "it gives $others key(s), none of them ssh-ed25519 -- the only kind nos's sshd takes (ssh-keygen -t ed25519 makes one)"
    else
        echo "it gives no key"
    fi
}

# KEYS and what KEY_URLS give, into KEYS_FILE
gather_keys() {
    local url got k
    : > "$KEYS_FILE"
    chmod 600 "$KEYS_FILE"
    for k in ${KEYS[@]+"${KEYS[@]}"}; do
        echo "$k" >> "$KEYS_FILE"
    done
    for url in ${KEY_URLS[@]+"${KEY_URLS[@]}"}; do
        if ! fetch_url "$url"; then
            say "keys: $url cannot be fetched -- is the network up?"
            continue
        fi
        got=$(fetched_ed25519)
        if [ -z "$got" ]; then
            say "keys: $url: $(fetch_why)"
            continue
        fi
        echo "$got" >> "$KEYS_FILE"
        say "keys: $(echo "$got" | wc -l) from $url"
    done
}

keys_count() {
    grep -c '^ssh-' "$KEYS_FILE" 2>/dev/null || true
}

# The ssh-ed25519 keys this system's root logs in with, a line each, options
# in front of one left out: on a provider's rescue system, the user's own
here_keys() {
    cat /root/.ssh/authorized_keys /root/.ssh/authorized_keys2 2>/dev/null | tr -d '\r' | awk '
        {
            for (i = 1; i < NF; i++) {
                if ($i != "ssh-ed25519") continue
                line = $i " " $(i + 1)
                for (j = i + 2; j <= NF; j++) line = line " " $j
                print line
                next
            }
        }' | grep -E '^ssh-ed25519 [A-Za-z0-9+/]+=*( .*)?$' | sort -u || true
}

fingerprints() {
    ssh-keygen -lf "$KEYS_FILE" 2>/dev/null || true
}

# ---- installing ---------------------------------------------------------

# Eject every CD drive: a provider's virtual media let go of, so that the
# firmware boots the disk next and not the installer again
eject_media() {
    local dev
    for dev in /dev/sr*; do
        [ -b "$dev" ] || continue
        eject "$dev" 2>/dev/null || true
    done
}

# nos-install disk with what was answered or chosen: DISK, ROOT_SIZE,
# WIPE, the network (NOS_NET: /etc/net.toml's), NETCONSOLE, NOS_CMDLINE,
# PANEL, NBS, NBS_HOST and the keys -- its lines on the screen and in the kernel log. $1
# "--dry-run" only says what it would write
run_install() {
    local args=(disk "$DISK" --root-size "$ROOT_SIZE") line
    [ "$WIPE" = 0 ] || args+=(--wipe)
    [ ! -s "$KEYS_FILE" ] || args+=(--ssh-key "$KEYS_FILE")
    args+=(${NOS_NET[@]+"${NOS_NET[@]}"})
    [ -z "$NETCONSOLE" ] || args+=(--netconsole "$NETCONSOLE")
    [ -z "$NOS_CMDLINE" ] || args+=(--cmdline "$NOS_CMDLINE")
    [ "$PANEL" = 0 ] || args+=(--panel)
    if [ "$NBS" = 1 ]; then
        args+=(--nbs --nbs-host "$NBS_HOST")
    fi
    [ -z "${1:-}" ] || args+=("$1")
    say "nos-install ${args[*]}"
    nos_install "${args[@]}" 2>&1 | while IFS= read -r line; do
        echo "$line"
        echo "$line" >> "$LOG"
        kmsg "$line"
    done
    return "${PIPESTATUS[0]}"
}

DISK=
ROOT_SIZE=$ROOT_SIZE_DEFAULT
WIPE=0
# nos's network, as nos-install's options: what it writes to /etc/net.toml
# on the root, which its plan (--dry-run) says
NOS_NET=(--dhcp)
# More kernel parameters (the answers' cmdline=)
NOS_CMDLINE=
NETCONSOLE=
PANEL=0
NBS=0
NBS_HOST=

nbs_host_default() {
    local name
    name=$(hostname 2>/dev/null | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9-]+/-/g' | cut -c1-63)
    name=${name#-}
    name=${name%-}
    [ -n "$name" ] || name=node
    printf '%s\n' "$name"
}

# nos's network a static address: IP, GW, DNS
net_static_chosen() {
    NOS_NET=(--ip "$IP" --gw "$GW" --dns "$DNS")
}

net_dhcp_chosen() {
    NOS_NET=(--dhcp)
}

# Whether $1 is a disk of nos's own already, of the image this installer
# carries: its root's /VERSION the image's, read with debugfs, which mounts
# nothing. What stops answers that reboot from installing again and again,
# when the firmware boots the installer before the disk
installed_here() {
    local disk part
    disk=$(readlink -f "$1")
    while IFS= read -r part; do
        [ -n "$part" ] || continue
        case "$part" in
            "$disk"[0-9]*|"$disk"p[0-9]*) ;;
            *) continue ;;
        esac
        if [ "$(debugfs -R "cat /VERSION" "$part" 2>/dev/null)" = "$(cat "$MNT/VERSION")" ]; then
            return 0
        fi
    done < <(blkid -c /dev/null -o device -t LABEL=nos 2>/dev/null || true)
    return 1
}

# ---- with answers -------------------------------------------------------

unattended() {
    local n after=${ANS[after]:-poweroff}
    touch "$DONE"
    KMSG_LEVEL=2
    say "installing $(image_version) as the answers say, asking nothing"
    DISK=${ANS[disk]}
    if [ -b "$DISK" ] && installed_here "$DISK"; then
        say "$DISK has $(image_version) on it already, as this installer would put it there: not installed again -- take the installer's medium out, and boot the disk"
        return 0
    fi
    ROOT_SIZE=${ANS[root_size]:-$ROOT_SIZE_DEFAULT}
    [ "${ANS[wipe]:-no}" != yes ] || WIPE=1
    NETCONSOLE=${ANS[netconsole]:-}
    NOS_CMDLINE=${ANS[cmdline]:-}
    [ "${ANS[panel]:-no}" != yes ] || PANEL=1
    if [ "${ANS[nbs]:-no}" = yes ]; then
        if [ "$PANEL" = 0 ]; then
            say "FAILED: nbs=yes needs panel=yes -- NBS is prepared for the panel here"
            return 1
        fi
        NBS=1
    fi
    if [ -n "${ANS[nbs_host]:-}" ] && [ "$NBS" = 0 ]; then
        say "FAILED: nbs_host goes with nbs=yes and panel=yes"
        return 1
    fi
    if [ "$NBS" = 1 ]; then
        NBS_HOST=${ANS[nbs_host]:-$(nbs_host_default)}
    fi
    wait_carrier || say "network: no card has a link"
    if [ -n "${ANS[ip]:-}" ]; then
        if ! valid_cidr "${ANS[ip]}" || ! valid_ip "${ANS[gw]:-}" || ! valid_ip "${ANS[dns]:-}"; then
            say "FAILED: ip= is A.B.C.D/N, and it takes gw= and dns=, each A.B.C.D"
            return 1
        fi
        IP=${ANS[ip]}; GW=${ANS[gw]}; DNS=${ANS[dns]}
        net_static_chosen
        net_static "$IP" "$GW" "$DNS" || say "network: the address did not take"
    else
        net_dhcp_chosen
        net_dhcp || true
    fi
    if [ -n "$NETCONSOLE" ]; then
        installer_netconsole "$NETCONSOLE" || say "the installer's kernel log cannot go to $NETCONSOLE: no route, or no answer from its next hop"
    fi
    gather_keys
    n=$(keys_count)
    [ "$n" -gt 0 ] || say "keys: none -- nos's sshd will let nobody in"
    if ! run_install; then
        say "FAILED: nos-install disk did not finish -- see above; nothing is rebooted"
        return 1
    fi
    say "done: nos is on $DISK"
    if in_vm; then
        say "this installer ran in a virtual machine: if it is a provider's over the server's disks (Selectel's qemu-iso), have the server's firmware boot nos first, in its rescue system: $RESCUE_LINE"
    fi
    case "$after" in
        reboot) eject_media; say "rebooting"; sync; reboot ;;
        poweroff) say "powering off"; sync; poweroff ;;
        *) say "staying: reboot when the installer's medium is gone" ;;
    esac
    return 0
}

# What the server's own rescue system runs to have its firmware boot the
# disk this installer made: nos-install boot --default, of the newest
# release's image, by the one-line installer (install.sh)
RESCUE_LINE="curl -fsSL https://nos-os.tech/install.sh | sh -s -- boot --default"

# ---- the dialog ---------------------------------------------------------

dialog_() {
    whiptail --title "$TITLE" "$@" 3>&1 1>&2 2>&3
}

msg() {
    whiptail --title "$TITLE" --msgbox "$1" 20 76
}

# In a virtual machine, at the end: the server's firmware was not this
# installer's to set, and what its rescue system runs instead -- one line, 67
# columns, which fits an 80-column serial console's box
rescue_box() {
    whiptail --title "$TITLE" --msgbox "This installer ran in a virtual machine. If that is the provider's way of installing from an ISO -- Selectel's qemu-iso runs one in QEMU over the server's disks -- the server's own firmware was out of its reach, and still boots what it booted before. In the server's rescue system, before it reboots, have it boot nos first:

$RESCUE_LINE

(docs/install.md, \"From a provider's rescue system\")" 18 76
    echo "nos-setup: in the server's rescue system, before its reboot: $RESCUE_LINE" >> "$LOG"
}

human() {
    numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1 bytes"
}

declare -A DISK_PROBLEM=() DISK_USED=() DISK_HOLDS=()

ask_disk() {
    local items=() dev size model serial problem used holds what choice
    DISK_PROBLEM=(); DISK_USED=(); DISK_HOLDS=()
    while IFS=$'\t' read -r dev size model serial problem used holds; do
        [ -n "$dev" ] || continue
        # nos-install disks says "-" for nothing
        [ "$used" != - ] || used=
        [ "$holds" != - ] || holds=
        DISK_PROBLEM[$dev]=$problem
        DISK_USED[$dev]=$used
        DISK_HOLDS[$dev]=$holds
        if [ "$problem" != ok ]; then
            what="nos cannot read it"
        elif [ -n "$used" ]; then
            what="in use"
        elif [ -n "$holds" ]; then
            what="holds data"
        else
            what="blank"
        fi
        items+=("$dev" "$(human "$size")  ${model/#-/} ${serial/#-/}  [$what]")
    done < <(nos_install disks 2>/dev/null)
    if [ "${#items[@]}" = 0 ]; then
        msg "No disks found.\n\nThe installer's Linux sees no disk on this machine."
        return 1
    fi
    while :; do
        choice=$(dialog_ --menu "Which disk is to be nos's? Everything on it is erased.\n\nnos reads NVMe, virtio, and SATA disks in IDE mode or behind AHCI -- not one behind a RAID controller." 20 76 8 "${items[@]}") || return 1
        if [ "${DISK_PROBLEM[$choice]}" != ok ]; then
            msg "nos cannot use $choice:\n\n${DISK_PROBLEM[$choice]}.\n\nGRUB could load nos from it, but nos would not find its root there."
            continue
        fi
        if [ -n "${DISK_USED[$choice]}" ]; then
            msg "$choice is in use: ${DISK_USED[$choice]}."
            continue
        fi
        DISK=$choice
        return 0
    done
}

ask_root_size() {
    local v
    while :; do
        v=$(dialog_ --inputbox "How big is nos's root to be? (M, G or T)\n\nThe rest of the disk is left as a partition with nothing on it, nos-data: for the VMs' disks and NBS." 14 76 "$ROOT_SIZE") || return 1
        if [[ "$v" =~ ^[0-9]{1,9}[MmGgTt]$ ]]; then
            ROOT_SIZE=$v
            return 0
        fi
        msg "$v is not a size: 10G, 512M, 1T."
    done
}

# In a virtual machine the installer's own network is the VM's, by DHCP:
# for fetching keys, whatever nos's is to be
vm_network() {
    wait_carrier || true
    net_dhcp >/dev/null 2>&1 || true
}

# nos's address, gateway and DNS server, in IP, GW and DNS as offered: each
# asked and checked, and what most networks have offered where none is --
# the gateway the network's first address, the DNS server the first of the
# gateway, 1.1.1.1 and 8.8.8.8 that answers. Asking those on the ISO sets up
# the installer's own network with the address; in a VM, whose network is
# not the server's, nothing is asked; on a Linux not the ISO's, its own
# network asks them, untouched
edit_address() {
    local gwnote dnsnote
    while :; do
        IP=$(dialog_ --inputbox "nos's address, with its prefix length (203.0.113.5/24):" 10 76 "$IP") || return 1
        if ! valid_cidr "$IP"; then
            msg "The address is A.B.C.D/N: 203.0.113.5/24."
            continue
        fi
        # Most networks' gateway is their first address
        gwnote=
        if [ -z "$GW" ]; then
            GW=$(first_host "$IP")
            [ -z "$GW" ] || gwnote=" -- the network's first address, where most networks have it"
        fi
        GW=$(dialog_ --inputbox "The gateway$gwnote:" 10 76 "$GW") || return 1
        valid_ip "$GW" || { msg "The gateway is A.B.C.D."; GW=; continue; }
        dnsnote=
        if [ -z "$DNS" ]; then
            if [ "$ON_ISO" = 0 ]; then
                DNS=$(dns_answering "$GW" 1.1.1.1 8.8.8.8 || true)
            elif ! in_vm; then
                # The first server that answers from this address
                wait_carrier || true
                net_static "$IP" "$GW" "$GW" >/dev/null 2>&1 || true
                DNS=$(dns_answering "$GW" 1.1.1.1 8.8.8.8 || true)
            fi
            [ -z "$DNS" ] || dnsnote=" -- it answers from here"
        fi
        DNS=$(dialog_ --inputbox "The DNS server$dnsnote:" 10 76 "${DNS:-$GW}") || return 1
        valid_ip "$DNS" || { msg "The DNS server is A.B.C.D."; DNS=; continue; }
        return 0
    done
}

IP=
GW=
DNS=

# The network, on a Linux not the ISO's: offered as it has it -- a
# provider's rescue system is up on the server's own address -- or as a
# Linux on the disks has it, or given; nothing of this system's is changed
ask_network_here() {
    local how here hip= hgw= hdns= w warn= found= items=() text
    net_dhcp_chosen
    text="How does nos get its address on this server's network?"
    here=$(nos_install network 2>/run/nos-network.why) || here=
    if [ -n "$here" ]; then
        for w in $here; do
            case "$w" in
                ip=*) hip=${w#ip=} ;;
                gw=*) hgw=${w#gw=} ;;
                dns=*) hdns=${w#dns=} ;;
            esac
        done
        items+=(here "$hip, gateway $hgw, DNS $hdns")
        text="$text\n\nhere: as this system has it -- a provider's rescue system is up on the server's own address."
        warn=$(sed -n 's/^nos-install: WARNING: --network-here: //p' /run/nos-network.why)
        [ -z "$warn" ] || text="$text\n\n$warn."
    else
        text="$text\n\nThis system's own cannot be offered: $(sed -n 's/^nos-install: \(--network-here: \)\{0,1\}//p' /run/nos-network.why | tail -n 1)."
    fi
    found=$(found_network || true)
    if [ -n "$found" ]; then
        set -- $found
        if [ "$1" = "$hip" ]; then
            found=
        else
            items+=(found "$1, gateway ${2/#-/none}, DNS ${3/#-/none}")
            text="$text\n\nfound: as a Linux on $4 has it ($5: $6)."
        fi
    fi
    items+=(static "A static address, given here" dhcp "By DHCP")
    how=$(dialog_ --menu "$text" 22 76 4 "${items[@]}") || return 1
    IP=; GW=; DNS=
    case "$how" in
        dhcp)
            whiptail --title "$TITLE" --defaultno --yesno "nos asks a DHCP server for its address at every boot. On a network with no DHCP server -- many dedicated servers' have none -- it boots unreachable.\n\nIs there a DHCP server on this server's network, for the server itself (not only the rescue system's)?" 14 76 || return 1
            return 0 ;;
        here) NOS_NET=(--network-here); return 0 ;;
        found)
            set -- $found
            IP=$1; GW=${2/#-/}; DNS=${3/#-/} ;;
        static) DNS=$hdns ;;
    esac
    edit_address || return 1
    net_static_chosen
}

ask_network() {
    local how found= items=() note= where=
    [ "$ON_ISO" = 1 ] || { ask_network_here; return; }
    net_dhcp_chosen
    # A provider's installer VM is behind QEMU's NAT: nothing tried here says
    # anything of the server's network
    if in_vm; then
        note="\n\nThis installer runs in a virtual machine: its network is not the server's, and nothing tried from here says anything of it."
    fi
    found=$(found_network || true)
    if [ -n "$found" ]; then
        set -- $found
        where="\n\nA Linux on $4 has a static address ($5: $6):"
        items+=(found "$1, gateway ${2/#-/none}, DNS ${3/#-/none}")
    fi
    items+=(static "A static address, given here: a network with no DHCP" dhcp "By DHCP")
    how=$(dialog_ --menu "How does nos get its address on this machine's network?$where$note" 19 76 3 "${items[@]}") || return 1
    case "$how" in
        dhcp)
            whiptail --title "$TITLE" --defaultno --yesno "nos asks a DHCP server for its address at every boot. On a network with no DHCP server -- many dedicated servers' have none -- it boots unreachable.$note\n\nIs there a DHCP server on this server's network?" 16 76 || return 1
            if in_vm; then
                vm_network
            else
                wait_carrier || true
                if ! net_dhcp; then
                    whiptail --title "$TITLE" --defaultno --yesno "No DHCP server answered the installer, on any port with a link.\n\nnos asks the same way at its boot. Go on with DHCP anyway?" 12 76 || return 1
                fi
            fi
            return 0 ;;
        found)
            set -- $found
            IP=$1; GW=${2/#-/}; DNS=${3/#-/} ;;
        static)
            IP=${ANS[ip]:-}; GW=${ANS[gw]:-}; DNS=${ANS[dns]:-} ;;
    esac
    edit_address || return 1
    ANS[ip]=$IP; ANS[gw]=$GW; ANS[dns]=$DNS
    net_static_chosen
    if in_vm; then
        vm_network
        return 0
    fi
    wait_carrier || true
    if net_static "$IP" "$GW" "$DNS" && ping -c 2 -W 2 "$GW" >/dev/null 2>&1; then
        msg "The gateway $GW answers the installer at $IP."
    else
        whiptail --title "$TITLE" --defaultno --yesno "The gateway $GW does not answer the installer at $IP.\n\nGo on with this address anyway?" 12 76 || return 1
    fi
}

ask_keys() {
    local choice line url user n items here=
    [ "$ON_ISO" = 1 ] || here=$(here_keys)
    while :; do
        n=$(keys_count)
        items=()
        [ -z "$here" ] || items+=(here "The keys root logs in with here: $(printf '%s\n' "$here" | wc -l) ssh-ed25519")
        items+=(paste "Paste a key line (ssh-ed25519 AAAA...)" url "Fetch keys from a URL"
            github "Fetch a GitHub user's keys" "done" "Done")
        choice=$(dialog_ --menu "nos is reached by SSH, with a key: which may log in? ($n so far)\n\nnos's sshd takes ssh-ed25519 keys only." 16 76 5 "${items[@]}") || return 1
        case "$choice" in
            here)
                printf '%s\n' "$here" > /run/nos-keys.new
                if whiptail --title "$TITLE" --yesno "/root/.ssh/authorized_keys here gives:\n\n$(ssh-keygen -lf /run/nos-keys.new 2>/dev/null)\n\nLet these in?" 18 76; then
                    cat /run/nos-keys.new >> "$KEYS_FILE"
                fi ;;
            paste)
                line=$(dialog_ --inputbox "The key, a line as in ~/.ssh/id_ed25519.pub:" 10 76) || continue
                if [[ "$line" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+=*(\ .*)?$ ]]; then
                    echo "$line" >> "$KEYS_FILE"
                else
                    msg "That is not an ssh-ed25519 key line."
                fi ;;
            url|github)
                if [ "$choice" = github ]; then
                    user=$(dialog_ --inputbox "The GitHub user:" 10 76) || continue
                    url=https://github.com/$user.keys
                else
                    url=$(dialog_ --inputbox "The URL (https://...):" 10 76 "https://") || continue
                fi
                if ! fetch_url "$url"; then
                    msg "$url cannot be fetched.\n\nIs the network up? (DHCP, or the static address)"
                    continue
                fi
                line=$(fetched_ed25519)
                if [ -z "$line" ]; then
                    msg "$url: $(fetch_why)."
                    continue
                fi
                echo "$line" > /run/nos-keys.new
                if whiptail --title "$TITLE" --yesno "$url gives:\n\n$(ssh-keygen -lf /run/nos-keys.new 2>/dev/null)\n\nLet these in?" 18 76; then
                    cat /run/nos-keys.new >> "$KEYS_FILE"
                fi ;;
            done)
                if [ "$n" -gt 0 ]; then
                    return 0
                fi
                whiptail --title "$TITLE" --yesno "No key: nos's sshd will let nobody in, and the machine is unreachable but by its console.\n\nGo on without one?" 12 76 && return 0 ;;
        esac
    done
}

ask_panel() {
    NBS=0
    NBS_HOST=
    if whiptail --title "$TITLE" --defaultno --yesno "Install the management panel?\n\nAt nos's first boot, a VM is created from Debian's cloud image and the panel's bundle, both downloaded. The panel then manages nos in a browser at https://<server>:39233.\n\nThe installer prints root's panel password once." 16 76; then
        PANEL=1
    else
        PANEL=0
    fi
}

ask_nbs() {
    local v
    [ "$PANEL" = 1 ] || return 0
    if ! whiptail --title "$TITLE" --defaultno --yesno "Enable NBS (replicated block storage)?\n\nThe cluster and NBS modules will start at every boot. This does not create a cluster, format nos-data or add a device: after installing every host alike, do Cluster init/invite/join and Block storage init/add host/add device in the panel. Volumes take three hosts." 18 76; then
        return 0
    fi
    NBS=1
    NBS_HOST=$(nbs_host_default)
    while :; do
        v=$(dialog_ --inputbox "This host's unique name in the cluster: lowercase letters, digits and -, up to 63 characters." 12 76 "$NBS_HOST") || return 1
        if [[ "$v" =~ ^[a-z0-9-]{1,63}$ ]]; then
            NBS_HOST=$v
            return 0
        fi
        whiptail --title "$TITLE" --msgbox "Use 1 to 63 lowercase letters, digits or -." 10 60
    done
}

ask_netconsole() {
    local v
    v=$(dialog_ --inputbox "Send nos's kernel log over UDP to a collector? IP:PORT, or leave it empty.\n\nOn a server whose console is its network, it is how a boot that dies is seen (docs/netconsole.md)." 12 76 "$NETCONSOLE") || return 1
    if [ -n "$v" ] && ! [[ "$v" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}:[0-9]{1,5}$ ]]; then
        msg "$v is not IP:PORT -- no netconsole."
        v=
    fi
    NETCONSOLE=$v
}

confirm() {
    local plan name typed rc fp
    plan=$(run_install --dry-run 2>&1)
    rc=$?
    plan=$(printf '%s\n' "$plan" | grep -v '^nos-setup: ' | sed 's/^nos-install: //')
    if [ "$rc" != 0 ]; then
        msg "nos-install refuses:\n\n$plan"
        return 1
    fi
    fp=$(fingerprints)
    if [ -n "$fp" ]; then
        fp="\n$fp"
    else
        fp="none -- nos's sshd will let nobody in"
    fi
    whiptail --title "$TITLE" --msgbox "What will be written:\n\n$plan\n\nThe keys let in: $fp" 24 76
    name=${DISK##*/}
    typed=$(dialog_ --inputbox "Everything on $DISK will be erased.\n${DISK_HOLDS[$DISK]:+It holds: ${DISK_HOLDS[$DISK]}\n}\nType $name to install nos onto it:" 14 76) || return 1
    [ "$typed" = "$name" ]
}

the_end() {
    local choice items=()
    if [ "$ON_ISO" = 0 ]; then
        items+=(exit "Back to this system's shell" reboot "Reboot now" install "Install again")
    else
        if [ "${2:-}" = installed ] && in_vm; then
            rescue_box
            items+=(rescue "What the server's rescue system runs before it reboots")
        fi
        items+=(reboot "Reboot (the installer's medium ejected where it can be)"
            poweroff "Power off" install "Install again" shell "A shell")
    fi
    while :; do
        if ! choice=$(dialog_ --menu "$1" 18 76 5 "${items[@]}"); then
            [ "$ON_ISO" = 1 ] && continue
            choice="exit"
        fi
        case "$choice" in
            rescue) rescue_box ;;
            reboot)
                [ "$ON_ISO" = 0 ] || eject_media
                sync; reboot; sleep 30 ;;
            poweroff) sync; poweroff; sleep 30 ;;
            install) return 0 ;;
            shell) clear; echo "nos installer: exit returns to the menu"; bash -l ;;
            exit) clear; exit 0 ;;
        esac
    done
}

# What is left to do, once nos is on DISK
done_text() {
    if [ "$ON_ISO" = 1 ]; then
        echo "$(image_version) is on $DISK.\n\nTake the installer's ISO out of the virtual media (or the USB stick out), and reboot."
    else
        echo "$(image_version) is on $DISK.\n\nIn the provider's panel, have the server boot its disks again instead of the rescue system; then reboot it."
    fi
}

interactive() {
    KMSG_LEVEL=6
    if [ "$ON_ISO" = 1 ] && in_vm; then
        whiptail --title "$TITLE" --msgbox "This installer runs in a virtual machine.\n\nIf that is the provider's way of installing from an ISO -- Selectel's qemu-iso runs one in QEMU, over the server's disks -- then:\n\n- the network here is QEMU's, not the server's: nos needs the server's address (a Linux already on its disks may have it, and is looked at);\n- the server's firmware is out of reach: its boot order is set in its rescue system after the install (said at the end).\n\nSimpler still: in the provider's rescue system, one command does it all on the server itself:\n\n  curl -fsSL https://nos-os.tech/install.sh | sh" 22 76
    fi
    while :; do
        : > "$KEYS_FILE"
        chmod 600 "$KEYS_FILE"
        WIPE=1
        if ask_disk && ask_root_size && ask_network && ask_keys && ask_netconsole && ask_panel && ask_nbs && confirm; then
            clear
            if run_install; then
                the_end "$(done_text)" installed
            else
                echo
                echo "nos-setup: nos-install did not finish -- press Enter"
                read -r _
                the_end "nos-install did not finish: see $LOG."
            fi
        else
            the_end "Nothing was written."
        fi
    done
}

# What the dialog needs on a Linux not the ISO's: root, the image it came
# in, a terminal, and its tools
here_ready() {
    local t missing=
    [ "$(id -u)" = 0 ] || { echo "nos-setup: run it as root" >&2; return 1; }
    if [ ! -x "$MNT/nos-install" ] || [ ! -f "$MNT/VERSION" ]; then
        echo "nos-setup: $MNT is not a system image: run the nos-setup of one, mounted (docs/install.md)" >&2
        return 1
    fi
    if [ ! -t 0 ] || [ ! -t 1 ]; then
        echo "nos-setup: the dialog needs a terminal -- without one, nos-install with its arguments (docs/install.md)" >&2
        return 1
    fi
    for t in whiptail curl ssh-keygen; do
        command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
    done
    if [ -n "$missing" ]; then
        echo "nos-setup: this Linux has no$missing (Debian, Ubuntu: apt-get install whiptail curl openssh-client; Arch: pacman -S libnewt curl openssh)" >&2
        return 1
    fi
}

: >> "$LOG"
if [ "$ON_ISO" = 1 ]; then
    read_answers
    if ! open_image; then
        sleep 5
        exec bash -l
    fi
    if [ -n "${ANS[disk]:-}" ] && [ ! -e "$DONE" ]; then
        unattended || true
        echo "nos-setup: press Enter for the menu"
        read -r _ || sleep 3600
    fi
else
    here_ready || exit 1
fi
interactive
