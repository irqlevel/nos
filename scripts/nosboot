#!/bin/sh
# Build the nos kernel, install it, and boot into it exactly once.
#
# Install as /usr/local/sbin/nosboot.
#
#   nosboot          build, install, arm one boot of nos, reboot
#   nosboot -n       build and install, do not reboot
#   nosboot -c       cancel an arming
#   nosboot -s       show what is installed and what is armed
#   nosboot --install-service   belt-and-braces disarm on every Ubuntu boot
#
# THE ONE-SHOT, AND WHY IT IS NOT grub-reboot.
#
# grub-reboot writes next_entry into $prefix/grubenv and relies on GRUB to
# clear it on the way past. $prefix is /boot; /boot here is ext3 on an mdadm
# mirror; and GRUB can read a diskfilter device but cannot write one. The
# clear fails silently, the selection sticks, and nos boots every time --
# including when nos itself reboots. On a machine with no console that is one
# that does not come back.
#
# So the flag lives on a plain partition GRUB can write, under its own name
# (nos_next), read and cleared by /etc/grub.d/01_nosenv before the menu is
# shown. GRUB clears it itself, which is what makes it one-shot: a hang plus a
# hardware reset comes back to Ubuntu with nothing left to do.
#
# Everything is guarded. If the partition is missing, or the file is, or the
# entry is not in grub.cfg, the arming does not happen and the machine boots
# its default. Failing to boot nos is not worth risking a boot over.

set -e

REPO=${NOSBOOT_REPO:-/root/nos}
KERNEL_SRC=$REPO/kernel64.elf
KERNEL_DST=${NOSBOOT_KERNEL:-/boot/nos-kernel64.elf}
ENTRY=${NOSBOOT_ENTRY:-nos-multiboot2}
NOSENV=${NOSBOOT_ENV:-/nosenv/grubenv}

die() { echo "nosboot: $*" >&2; exit 1; }
armed() { grub-editenv "$NOSENV" list 2>/dev/null | sed -n 's/^nos_next=//p'; }

status() {
    if [ -f "$KERNEL_DST" ]; then
        echo "installed: $KERNEL_DST ($(stat -c %y "$KERNEL_DST" | cut -d. -f1))"
    else
        echo "installed: nothing at $KERNEL_DST"
    fi
    [ -d "$REPO/.git" ] && echo "repo:      $(git -C "$REPO" log --oneline -1 2>/dev/null)"
    if [ ! -f "$NOSENV" ]; then
        echo "one-shot:  unavailable, no environment at $NOSENV"
        return
    fi
    a=$(armed)
    if [ -n "$a" ]; then
        echo "armed:     the next boot only is '$a'"
    else
        echo "armed:     no, the next boot is the default (Ubuntu)"
    fi
}

install_service() {
    cat > /etc/systemd/system/nos-grub-reset.service <<'UNIT'
[Unit]
Description=Cancel any nos one-shot boot selection left standing
# GRUB clears the flag itself, so this should never find anything to do. It is
# here for the case where it did not: reaching Ubuntu once then guarantees
# staying there, whatever went wrong on the way.
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
ExecStart=-/usr/bin/grub-editenv /nosenv/grubenv unset nos_next
ExecStart=-/usr/bin/grub-editenv /boot/grub/grubenv unset next_entry
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
UNIT
    systemctl daemon-reload
    systemctl enable nos-grub-reset.service
    echo "nosboot: installed and enabled nos-grub-reset.service"
}

REBOOT=yes
case "$1" in
    -s|--status) status; exit 0 ;;
    -c|--clear)
        grub-editenv "$NOSENV" unset nos_next 2>/dev/null || true
        echo "nosboot: cancelled; the next boot is Ubuntu"
        exit 0 ;;
    -n|--no-reboot) REBOOT=no ;;
    --install-service) install_service; exit 0 ;;
    "") ;;
    *) die "usage: nosboot [-n|-c|-s|--install-service]" ;;
esac

[ -d "$REPO" ] || die "no repository at $REPO"

echo "nosboot: building in $REPO"
make -C "$REPO" nocheck >/dev/null || die "build failed"
[ -f "$KERNEL_SRC" ] || die "no kernel at $KERNEL_SRC after the build"

cp "$KERNEL_SRC" "$KERNEL_DST"
sync
echo "nosboot: installed $(git -C "$REPO" log --oneline -1 2>/dev/null)"

# Refuse to arm what GRUB cannot act on. Arming a name it does not know boots
# the default instead, which presents as the script silently doing nothing.
grep -q "$ENTRY" /boot/grub/grub.cfg || die "no menu entry '$ENTRY' in grub.cfg"
[ -f "$NOSENV" ] || die "no environment at $NOSENV; see /etc/grub.d/01_nosenv"

grub-editenv "$NOSENV" set nos_next="$ENTRY"
sync
echo "nosboot: armed '$ENTRY' for the next boot only"

if [ "$REBOOT" = no ]; then
    echo "nosboot: not rebooting (-n)"
    exit 0
fi

echo "nosboot: rebooting; the boot after this one is Ubuntu again"
exec reboot
